generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Top KPI cards (two rows on the dashboard)
model Kpi {
  id         String @id @default(cuid())
  group      String // "primary" | "secondary"
  key        String @unique
  label      String
  value      String
  delta      String
  deltaLabel String
  trend      String // "up" | "down" | "ai"
  icon       String // lucide icon name
  sortOrder  Int

  @@index([group])
}

/// Monthly revenue vs target for the bar chart
model RevenueMonth {
  id        String  @id @default(cuid())
  month     String
  revenue   Int
  target    Int
  isCurrent Boolean @default(false)
  sortOrder Int     @unique
}

/// Top deals closing this month
model Deal {
  id          String @id @default(cuid())
  company     String
  name        String
  initials    String
  avatarColor String
  probability Int
  amount      Int
  sortOrder   Int    @unique
}

/// Recent activity feed
model Activity {
  id        String @id @default(cuid())
  title     String
  source    String
  timeAgo   String
  icon      String // lucide icon name
  variant   String // success | brand | ai | accent | error
  sortOrder Int    @unique
}

/// Sales leaderboard (Q2)
model LeaderboardEntry {
  id          String @id @default(cuid())
  rank        Int    @unique
  name        String
  role        String
  initials    String
  avatarColor String
  deals       Int
  quotaPct    Int
  amount      Int
}

/// Revenue by region (donut chart)
model Region {
  id        String @id @default(cuid())
  name      String
  color     String
  amount    Int
  pct       Int
  sortOrder Int    @unique
}

// ============================================================================
//  ACCOUNTING MODULE
//  All monetary fields use Decimal(18,2). The dashboard models above keep Int.
// ============================================================================

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  COST
  EXPENSE
}

enum NormalSide {
  DEBIT
  CREDIT
}

enum EntryType {
  MANUAL
  AUTOMATIC
  RECURRING
  CLOSING
}

enum EntryStatus {
  DRAFT
  POSTED
  REVERSED
}

enum PeriodType {
  MONTH
  YEAR
}

enum PeriodStatus {
  OPEN
  CLOSED
  LOCKED
}

enum DepreciationMethod {
  STRAIGHT_LINE // línea recta (default)
  DECLINING_BALANCE // saldos decrecientes
  UNITS_OF_PRODUCTION // unidades de producción
}

enum AssetStatus {
  ACTIVE // en uso, depreciándose
  FULLY_DEPRECIATED // valor en libros = valor residual
  DISPOSED // dado de baja / vendido
}

enum PaymentDirection {
  INBOUND // we receive money (customer pays us)
  OUTBOUND // we pay money (we pay a supplier)
}

enum DocStatus {
  ISSUED
  PARTIAL
  PAID
  VOID
}

/// Accounting direction of a stock movement. OUT emits inventory.cost.posted → COGS.
/// TRANSFER moves stock between warehouses without touching the P&L.
enum MovementType {
  IN
  OUT
  TRANSFER
}

/// Business reason behind a kardex movement (full traceability requirement).
enum KardexReason {
  OPENING // saldo inicial
  PURCHASE // compra
  SALE // venta
  TRANSFER // transferencia entre bodegas
  ADJUSTMENT // ajuste (conteo / corrección)
  RETURN // devolución
  INTERNAL_CONSUMPTION // consumo interno
  PRODUCTION // producción / ensamble
  LOSS // pérdida
  THEFT // robo
  DAMAGE // daño
}

/// Nature of a product — drives stock & costing behaviour.
enum ProductType {
  PHYSICAL // producto físico
  RAW_MATERIAL // materia prima
  FINISHED_GOOD // producto terminado
  CONSUMABLE // consumible
  SPARE_PART // repuesto
  TOOL // herramienta
  ASSET // activo
}

enum CostingMethod {
  AVERAGE // costo promedio ponderado
  STANDARD // costo estándar
  LAST // último costo
}

enum WarehouseType {
  MAIN // principal
  SECONDARY // secundaria
  PRODUCTION // producción
  WORKSHOP // taller
  VEHICLE // vehículos
  CONSIGNMENT // consignación
  TRANSIT // tránsito
}

/// Level within a warehouse's internal location tree: Zona→Pasillo→Estante→Ubicación.
enum LocationKind {
  ZONE
  AISLE
  RACK
  BIN
}

enum SerialStatus {
  IN_STOCK
  ASSIGNED
  SOLD
  IN_REPAIR
  RETIRED
  LOST
}

/// Shared approval lifecycle for purchase orders & adjustments.
enum FlowStatus {
  DRAFT // borrador
  PENDING // pendiente de aprobación
  APPROVED // aprobada
  PARTIAL // parcialmente atendida
  COMPLETED // completada
  CANCELLED // cancelada
}

enum ReceiptCondition {
  OK // recibido conforme
  DAMAGED // dañado
  MISSING // faltante
}

enum AdjustmentReason {
  DAMAGE // daño
  THEFT // robo
  LOSS // pérdida
  OPERATIONAL_ERROR // error operativo
  ADMIN_CORRECTION // corrección administrativa
  COUNT_DIFFERENCE // diferencia de conteo
}

enum AssetAssignmentStatus {
  ASSIGNED // en poder del empleado
  RETURNED // devuelto
  LOST // perdido
}

enum TaxKind {
  SALES
  PURCHASE
  WITHHOLDING
}

enum WithholdingBase {
  SUBTOTAL
  TAX
}

enum PartyKind {
  CUSTOMER
  SUPPLIER
  BOTH
}

/// Chart of accounts — hierarchical tree (Activo, Pasivo, Patrimonio, Ingreso, Costo, Gasto)
model Account {
  id         String      @id @default(cuid())
  code       String      @unique
  name       String
  type       AccountType
  normalSide NormalSide
  parentId   String?
  parent     Account?    @relation("AccountTree", fields: [parentId], references: [id])
  children   Account[]   @relation("AccountTree")
  level      Int         @default(1)
  isPostable Boolean     @default(true) // only leaf accounts accept journal lines
  isActive   Boolean     @default(true)
  currency   String      @default("USD")

  lines        JournalLine[]
  taxCodes     TaxCode[]
  mappings     AccountMapping[]
  bankAccounts BankAccount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([parentId])
}

/// Cost centers — hierarchical, optional on every journal line
model CostCenter {
  id       String       @id @default(cuid())
  code     String       @unique
  name     String
  parentId String?
  parent   CostCenter?  @relation("CostCenterTree", fields: [parentId], references: [id])
  children CostCenter[] @relation("CostCenterTree")
  isActive Boolean      @default(true)

  lines              JournalLine[]
  inventoryMovements InventoryMovement[] // salidas de inventario imputadas a este centro de costo
  createdAt          DateTime            @default(now())
}

/// Fiscal periods drive the accounting close (monthly + annual)
model FiscalPeriod {
  id        String         @id @default(cuid())
  name      String
  type      PeriodType     @default(MONTH)
  year      Int
  month     Int? // 1-12 for MONTH periods, null for YEAR
  startDate DateTime
  endDate   DateTime
  status    PeriodStatus   @default(OPEN)
  closedAt  DateTime?
  entries   JournalEntry[]
  createdAt DateTime       @default(now())

  @@unique([year, month])
  @@index([status])
}

/// Journal entry (asiento) — manual, automatic, recurring or closing
model JournalEntry {
  id          String        @id @default(cuid())
  number      Int           @unique
  date        DateTime
  periodId    String?
  period      FiscalPeriod? @relation(fields: [periodId], references: [id])
  type        EntryType     @default(MANUAL)
  status      EntryStatus   @default(POSTED)
  description String
  reference   String?
  sourceType  String? // SALES_INVOICE | PURCHASE_BILL | PAYMENT | INVENTORY | MANUAL | CLOSING | RECURRING
  sourceId    String?
  createdBy   String?

  // self relation for reversals (1-1)
  reversedById String?       @unique
  reversedBy   JournalEntry? @relation("Reversal", fields: [reversedById], references: [id])
  reversalOf   JournalEntry? @relation("Reversal")

  lines     JournalLine[]
  createdAt DateTime      @default(now())

  @@unique([sourceType, sourceId]) // idempotency: one source doc -> one entry
  @@index([date])
  @@index([status])
}

/// Journal line — exactly one of debit/credit is > 0
model JournalLine {
  id           String       @id @default(cuid())
  entryId      String
  entry        JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId    String
  account      Account      @relation(fields: [accountId], references: [id])
  costCenterId String?
  costCenter   CostCenter?  @relation(fields: [costCenterId], references: [id])
  debit        Decimal      @default(0) @db.Decimal(18, 2)
  credit       Decimal      @default(0) @db.Decimal(18, 2)
  description  String?
  lineOrder    Int          @default(0)

  @@index([accountId])
  @@index([entryId])
}

/// Recurring entry template — materialized into real entries when due
model RecurringTemplate {
  id          String    @id @default(cuid())
  name        String
  description String
  frequency   String    @default("MONTHLY") // MONTHLY | QUARTERLY | YEARLY
  nextRunDate DateTime
  isActive    Boolean   @default(true)
  lines       Json // [{ accountId, costCenterId?, debit, credit, description? }]
  lastRunAt   DateTime?
  createdAt   DateTime  @default(now())
}

/// Configurable tax engine — country agnostic (rate + linked GL account)
model TaxCode {
  id        String          @id @default(cuid())
  code      String          @unique
  name      String
  kind      TaxKind         @default(SALES)
  // 6 decimals so per-mil withholdings (ReteICA, e.g. 0.009660) are exact.
  rate      Decimal         @db.Decimal(9, 6) // e.g. 0.190000 = 19%
  // For WITHHOLDING codes: which amount the rate applies to.
  //   SUBTOTAL → ReteFuente / ReteICA (over the base value)
  //   TAX      → ReteIVA (over the IVA amount)
  base      WithholdingBase @default(SUBTOTAL)
  accountId String
  account   Account         @relation(fields: [accountId], references: [id])
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
}

/// Maps domain events to GL accounts (configurable in DB, not hardcoded)
model AccountMapping {
  id          String  @id @default(cuid())
  key         String  @unique // SALES_AR, SALES_REVENUE, SALES_TAX, PURCHASE_AP, PURCHASE_EXPENSE, PURCHASE_TAX, BANK_DEFAULT, COGS, INVENTORY, RETAINED_EARNINGS, INCOME_SUMMARY
  accountId   String
  account     Account @relation(fields: [accountId], references: [id])
  description String?
}

/// Fixed-asset category — carries the depreciation policy and the GL accounts
/// (cost / expense / accumulated) so every asset in it posts consistently.
/// Account ids point at Account.id but are kept as plain strings (configurable,
/// same philosophy as AccountMapping) to avoid coupling the chart of accounts.
model FixedAssetCategory {
  id                               String             @id @default(cuid())
  code                             String             @unique
  name                             String
  method                           DepreciationMethod @default(STRAIGHT_LINE)
  usefulLifeMonths                 Int                @default(60)
  assetAccountId                   String // GL: costo del activo
  depreciationExpenseAccountId     String // GL: gasto depreciación
  accumulatedDepreciationAccountId String // GL: depreciación acumulada (contra-activo)
  isActive                         Boolean            @default(true)
  assets                           FixedAsset[]
  createdAt                        DateTime           @default(now())
}

/// Fixed asset (propiedad, planta y equipo). Book value = acquisitionCost -
/// accumulatedDepreciation; never depreciated below residualValue.
model FixedAsset {
  id                      String              @id @default(cuid())
  code                    String              @unique
  name                    String
  categoryId              String
  category                FixedAssetCategory  @relation(fields: [categoryId], references: [id])
  costCenterId            String? // imputación del gasto de depreciación
  acquisitionDate         DateTime
  inServiceDate           DateTime // fecha desde la que se deprecia
  acquisitionCost         Decimal             @db.Decimal(18, 2)
  residualValue           Decimal             @default(0) @db.Decimal(18, 2)
  usefulLifeMonths        Int
  method                  DepreciationMethod  @default(STRAIGHT_LINE)
  status                  AssetStatus         @default(ACTIVE)
  accumulatedDepreciation Decimal             @default(0) @db.Decimal(18, 2)
  acquisitionEntryId      String? // asiento de capitalización (opcional)
  disposalDate            DateTime?
  disposalProceeds        Decimal?            @db.Decimal(18, 2)
  disposalEntryId         String? // asiento de baja/venta
  notes                   String?
  depreciations           DepreciationEntry[]
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  @@index([categoryId])
  @@index([status])
}

/// One depreciation charge per asset per month — idempotent by (asset, year, month).
model DepreciationEntry {
  id               String     @id @default(cuid())
  assetId          String
  asset            FixedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  year             Int
  month            Int // 1-12
  date             DateTime // último día del mes depreciado
  amount           Decimal    @db.Decimal(18, 2)
  accumulatedAfter Decimal    @db.Decimal(18, 2)
  bookValueAfter   Decimal    @db.Decimal(18, 2)
  journalEntryId   String? // asiento generado (Dr gasto / Cr dep. acumulada)
  createdAt        DateTime   @default(now())

  @@unique([assetId, year, month])
  @@index([assetId])
}

/// Atomic counters (e.g. journal entry numbering)
model Sequence {
  key   String @id
  value Int    @default(0)
}

// --- Source stubs (emit domain events; accounting reacts) ---

/// Unified customer/supplier — base for receivables & payables
model Party {
  id                 String              @id @default(cuid())
  kind               PartyKind           @default(CUSTOMER)
  name               String
  taxId              String?
  email              String?
  phone              String?
  isActive           Boolean             @default(true)
  invoices           SalesInvoice[]
  bills              PurchaseBill[]
  payments           Payment[]
  sstContractor      SstContractor? // ficha de contratista SST (opcional)
  inventoryMovements InventoryMovement[] // movimientos de inventario con este tercero como contraparte
  subscribers        Subscriber[] // suscriptores ISP vinculados a este tercero (cuentas por cobrar)
  createdAt          DateTime            @default(now())
}

model SalesInvoice {
  id             String             @id @default(cuid())
  number         String             @unique
  partyId        String
  party          Party              @relation(fields: [partyId], references: [id])
  date           DateTime
  dueDate        DateTime
  subtotal       Decimal            @db.Decimal(18, 2)
  taxTotal       Decimal            @db.Decimal(18, 2)
  total          Decimal            @db.Decimal(18, 2)
  balance        Decimal            @db.Decimal(18, 2)
  status         DocStatus          @default(ISSUED)
  taxCodeId      String?
  journalEntryId String?
  payments       Payment[]
  lines          SalesInvoiceLine[]
  createdAt      DateTime           @default(now())

  @@index([partyId])
}

model PurchaseBill {
  id             String             @id @default(cuid())
  number         String             @unique
  partyId        String
  party          Party              @relation(fields: [partyId], references: [id])
  date           DateTime
  dueDate        DateTime
  subtotal       Decimal            @db.Decimal(18, 2)
  taxTotal       Decimal            @db.Decimal(18, 2)
  total          Decimal            @db.Decimal(18, 2)
  balance        Decimal            @db.Decimal(18, 2)
  status         DocStatus          @default(ISSUED)
  taxCodeId      String?
  journalEntryId String?
  payments       Payment[]
  lines          PurchaseBillLine[]
  goodsReceiptId String? // recepción que originó la factura
  createdAt      DateTime           @default(now())

  @@index([partyId])
}

model BankAccount {
  id             String              @id @default(cuid())
  name           String
  accountNumber  String?
  glAccountId    String
  glAccount      Account             @relation(fields: [glAccountId], references: [id])
  currency       String              @default("USD")
  balance        Decimal             @default(0) @db.Decimal(18, 2)
  movements      BankMovement[]
  statementLines BankStatementLine[]
  createdAt      DateTime            @default(now())
}

model BankMovement {
  id              String             @id @default(cuid())
  bankAccountId   String
  bankAccount     BankAccount        @relation(fields: [bankAccountId], references: [id])
  date            DateTime
  description     String
  amount          Decimal            @db.Decimal(18, 2) // signed: + inbound, - outbound
  paymentId       String?
  reconciled      Boolean            @default(false)
  statementLineId String?            @unique
  statementLine   BankStatementLine? @relation(fields: [statementLineId], references: [id])
  createdAt       DateTime           @default(now())

  @@index([bankAccountId])
}

model BankStatementLine {
  id            String        @id @default(cuid())
  bankAccountId String
  bankAccount   BankAccount   @relation(fields: [bankAccountId], references: [id])
  date          DateTime
  description   String
  amount        Decimal       @db.Decimal(18, 2)
  matched       Boolean       @default(false)
  movement      BankMovement?
  createdAt     DateTime      @default(now())

  @@index([bankAccountId])
}

model Payment {
  id             String           @id @default(cuid())
  direction      PaymentDirection
  date           DateTime
  amount         Decimal          @db.Decimal(18, 2)
  partyId        String?
  party          Party?           @relation(fields: [partyId], references: [id])
  bankAccountId  String
  invoiceId      String?
  invoice        SalesInvoice?    @relation(fields: [invoiceId], references: [id])
  billId         String?
  bill           PurchaseBill?    @relation(fields: [billId], references: [id])
  journalEntryId String?
  reference      String?
  createdAt      DateTime         @default(now())
}

/// Inventory movement header. Every stock change creates one of these plus a
/// matching KardexEntry — stock is NEVER mutated without traceability.
/// Kept backward-compatible: `productName` is retained (denormalised label) and
/// the legacy fields still drive the accounting posting on OUT movements.
model InventoryMovement {
  id          String       @id @default(cuid())
  reference   String? // documento origen (factura, OC, ajuste…)
  type        MovementType
  reason      KardexReason @default(ADJUSTMENT)
  productName String // denormalised for legacy/audit readability

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  warehouseFromId String?
  warehouseFrom   Warehouse? @relation("MovementFrom", fields: [warehouseFromId], references: [id])
  warehouseToId   String?
  warehouseTo     Warehouse? @relation("MovementTo", fields: [warehouseToId], references: [id])

  serialId String?
  serial   SerialNumber? @relation(fields: [serialId], references: [id])

  // ---- Contraparte (de dónde / hacia dónde) más allá de la bodega ----------
  // Da trazabilidad real al kardex: una ENTRADA viene de un proveedor; una
  // SALIDA va hacia un funcionario, un centro de costo/área o un tercero externo
  // (contratista). Todas opcionales: si no aplica, la columna se deriva del motivo.
  partyId String? // proveedor (IN) o tercero/contratista externo (OUT)
  party   Party?  @relation(fields: [partyId], references: [id])

  counterpartyEmployeeId String? // funcionario que recibe el material (OUT)
  counterpartyEmployee   Employee? @relation(fields: [counterpartyEmployeeId], references: [id])

  costCenterId String? // centro de costo / área que consume (OUT)
  costCenter   CostCenter? @relation(fields: [costCenterId], references: [id])

  quantity  Decimal  @db.Decimal(18, 4)
  unitCost  Decimal  @db.Decimal(18, 4)
  totalCost Decimal  @db.Decimal(18, 2)
  date      DateTime

  /// Document that originated the movement (polymorphic, e.g. GOODS_RECEIPT, ADJUSTMENT, SALES_INVOICE).
  sourceType String?
  sourceId   String?

  userId String? // quién realizó el movimiento
  user   User?   @relation(fields: [userId], references: [id])

  notes          String?
  journalEntryId String?
  kardex         KardexEntry[]
  createdAt      DateTime      @default(now())

  @@index([productId])
  @@index([warehouseFromId])
  @@index([warehouseToId])
  @@index([partyId])
  @@index([counterpartyEmployeeId])
  @@index([costCenterId])
  @@index([date])
}

// ============================================================================
//  AUTH MODULE (User / Role / Permission) — activates the existing
//  PermissionsGuard, which already reads req.user.permissions.
// ============================================================================

model User {
  id                    String              @id @default(cuid())
  email                 String              @unique
  name                  String
  passwordHash          String
  isActive              Boolean             @default(true)
  // Teléfono de WhatsApp en E.164 sin '+' (ej. 573001112233). Vincula el número
  // entrante del chatbot con este usuario para heredar sus permisos RBAC.
  whatsappPhone         String?             @unique
  /// Caja asignada a esta cajera. Port del legacy `asignaciones` (detalle='caja',
  /// colaborador=usuario) -> `tipo`, que es lo que usa `acc_list()` para que cada cajera
  /// sólo vea la suya.
  ///
  /// Guarda el `CashAccount.legacyId` (Int) y NO el cuid: el legacyId es el id que hablan
  /// las transacciones y toda la API de tesorería, y las cajas "derivadas" (las que
  /// aparecen en transacciones viejas sin fila propia) ni siquiera tienen cuid.
  ///
  /// null en una cajera = sin caja asignada -> sólo ve los bancos, igual que el legacy
  /// (allá `$asignacion` sale null y el `where('id', null)` no casa con nada).
  cajaLegacyId          Int?
  /// Sedes a las que accede. Port de `aauth_users.sede_accede` ('-2-,-3-,-4-').
  /// **VACÍO = TODAS**, que es el '0' del legacy (así lo tienen gerencia y admin).
  /// Guarda `Branch.legacyId`, que es el mismo espacio de ids que `accounts.sede`
  /// (verificado: 2=Yopal, 3=Villanueva, 4=Monterrey, 5=Mocoa, 6=Aguazul, 7=Tauramena).
  sedesAccede           Int[]
  roles                 UserRole[]
  permissionOverrides   UserPermission[] // ajustes por empleado (ALLOW/DENY sobre el rol)
  movements             InventoryMovement[]
  auditLogs             AuditLog[]
  employee              Employee? // perfil de empleado SST/RRHH (1-1 opcional)
  workOrdersAssigned    WorkOrder[]         @relation("WorkOrderAssignee") // órdenes de trabajo asignadas (técnico)
  workOrdersCreated     WorkOrder[]         @relation("WorkOrderCreatedBy") // órdenes de trabajo creadas (jefe)
  warehousesResponsible Warehouse[]         @relation("WarehouseResponsible") // bodegas de las que es responsable
  createdAt             DateTime            @default(now())
}

model Role {
  id          String           @id @default(cuid())
  key         String           @unique // e.g. "inventory-manager"
  name        String
  description String?
  area        String? // grupo para la UI (roles personalizados); los del catálogo lo derivan de ROLE_AREA_BY_KEY
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
}

model Permission {
  id            String           @id @default(cuid())
  key           String           @unique // e.g. "inventory.products.write"
  label         String
  roles         RolePermission[]
  userOverrides UserPermission[]
}

/// Ajuste de acceso por EMPLEADO (encima de sus roles). Réplica del modelo
/// legacy (roleid base + flags por usuario en `permisos_usuario`).
/// effect=ALLOW concede un permiso extra; effect=DENY revoca uno que el rol daría.
model UserPermission {
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  effect       String     @default("ALLOW") // "ALLOW" | "DENY"
  createdAt    DateTime   @default(now())

  @@id([userId, permissionId])
}

model UserRole {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

// ============================================================================
//  INVENTORY — CATALOG
// ============================================================================

model Category {
  id        String     @id @default(cuid())
  code      String     @unique
  name      String
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]
  createdAt DateTime   @default(now())
}

model Brand {
  id        String    @id @default(cuid())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

/// Unit of measure (UND, KG, MT, CAJA…).
model UnitOfMeasure {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id           String      @id @default(cuid())
  sku          String      @unique // código único de inventario
  internalCode String?     @unique // código interno
  barcode      String?     @unique // código de barras
  name         String
  description  String?
  type         ProductType @default(PHYSICAL)
  isActive     Boolean     @default(true)

  categoryId String?
  category   Category?      @relation(fields: [categoryId], references: [id])
  brandId    String?
  brand      Brand?         @relation(fields: [brandId], references: [id])
  uomId      String?
  uom        UnitOfMeasure? @relation(fields: [uomId], references: [id])

  costingMethod CostingMethod @default(AVERAGE)
  lastCost      Decimal       @default(0) @db.Decimal(18, 4) // último costo
  averageCost   Decimal       @default(0) @db.Decimal(18, 4) // costo promedio ponderado
  standardCost  Decimal       @default(0) @db.Decimal(18, 4) // costo estándar

  trackSerials Boolean @default(false) // requiere número de serie

  entryDate DateTime @default(now()) // fecha de ingreso/alta del producto (editable)

  stockLevels         StockLevel[]
  kardex              KardexEntry[]
  movements           InventoryMovement[]
  serials             SerialNumber[]
  reorderRules        ReorderRule[]
  poLines             POLine[]
  grLines             GRLine[]
  salesLines          SalesInvoiceLine[]
  purchaseLines       PurchaseBillLine[]
  sstEppDeliveries    SstEppDelivery[] // entregas de EPP (SST) — EPP es un Product
  materialAssignments MaterialAssignment[] // material asignado a funcionarios (custodia)

  maintenances     MaintenanceOrder[] // mantenimientos sobre este producto (sin serie)
  maintenanceParts MaintenancePart[] // consumido como repuesto en mantenimientos
  workOrderParts   WorkOrderPart[] // consumido como repuesto en órdenes de trabajo

  createdAt DateTime @default(now())

  @@index([categoryId])
  @@index([brandId])
  @@index([entryDate])
}

// ============================================================================
//  INVENTORY — WAREHOUSES & LOCATIONS
// ============================================================================

model Warehouse {
  id            String        @id @default(cuid())
  code          String        @unique
  name          String
  type          WarehouseType @default(MAIN)
  address       String?
  isActive      Boolean       @default(true)
  responsibleId String? // responsable (User)
  responsible   User?         @relation("WarehouseResponsible", fields: [responsibleId], references: [id])

  locations     Location[]
  stockLevels   StockLevel[]
  kardex        KardexEntry[]
  movementsFrom InventoryMovement[] @relation("MovementFrom")
  movementsTo   InventoryMovement[] @relation("MovementTo")
  createdAt     DateTime            @default(now())
}

/// Hierarchical internal location: Zona → Pasillo → Estante → Ubicación.
model Location {
  id          String       @id @default(cuid())
  warehouseId String
  warehouse   Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  kind        LocationKind
  code        String
  name        String
  parentId    String?
  parent      Location?    @relation("LocationTree", fields: [parentId], references: [id])
  children    Location[]   @relation("LocationTree")
  stockLevels StockLevel[]
  createdAt   DateTime     @default(now())

  @@unique([warehouseId, code])
  @@index([warehouseId])
}

/// Current quantity of a product at a (warehouse[, location]) slot.
/// `reserved` = comprometido por ventas; available = onHand - reserved.
model StockLevel {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  locationId  String?
  location    Location? @relation(fields: [locationId], references: [id])

  onHand    Decimal  @default(0) @db.Decimal(18, 4)
  reserved  Decimal  @default(0) @db.Decimal(18, 4)
  updatedAt DateTime @updatedAt

  @@unique([productId, warehouseId, locationId])
  @@index([productId])
  @@index([warehouseId])
}

// ============================================================================
//  INVENTORY — KARDEX (immutable running ledger per product/warehouse)
// ============================================================================

/// One row per stock movement. Stores the running balance & average cost AFTER
/// the movement (kardex valorizado). Never updated once written.
model KardexEntry {
  id          String       @id @default(cuid())
  date        DateTime
  productId   String
  product     Product      @relation(fields: [productId], references: [id])
  warehouseId String
  warehouse   Warehouse    @relation(fields: [warehouseId], references: [id])
  reason      KardexReason
  direction   MovementType

  // A TRANSFER writes TWO entries (OUT origen + IN destino) for the same movement,
  // so this is no longer 1-1 with InventoryMovement.
  movementId String
  // Restrict: el kardex es un libro inmutable. Borrar un movimiento NO debe poder
  // destruir filas del kardex y corromper los saldos corrientes posteriores.
  movement   InventoryMovement @relation(fields: [movementId], references: [id], onDelete: Restrict)

  quantityIn   Decimal @default(0) @db.Decimal(18, 4)
  quantityOut  Decimal @default(0) @db.Decimal(18, 4)
  unitCost     Decimal @db.Decimal(18, 4)
  // Running figures AFTER applying this movement:
  balanceQty   Decimal @db.Decimal(18, 4)
  balanceValue Decimal @db.Decimal(18, 2)
  avgCost      Decimal @db.Decimal(18, 4)

  reference String?
  userId    String?
  createdAt DateTime @default(now())

  @@index([productId, warehouseId, date])
  @@index([movementId])
}

// ============================================================================
//  INVENTORY — SERIALS
// ============================================================================

model SerialNumber {
  id          String       @id @default(cuid())
  serial      String       @unique
  productId   String
  product     Product      @relation(fields: [productId], references: [id])
  status      SerialStatus @default(IN_STOCK)
  warehouseId String?
  notes       String?

  movements    InventoryMovement[]
  assignments  AssetAssignment[]
  maintenances MaintenanceOrder[] // mantenimientos sobre esta unidad
  createdAt    DateTime            @default(now())

  @@index([productId])
}

// ============================================================================
//  INVENTORY — PURCHASE ORDERS & GOODS RECEIPTS
// ============================================================================

model PurchaseOrder {
  id          String     @id @default(cuid())
  number      String     @unique
  supplierId  String // Party
  warehouseId String? // bodega destino
  status      FlowStatus @default(DRAFT)
  orderDate   DateTime
  expectedAt  DateTime?
  notes       String?

  requestedById String?
  approvedById  String?
  approvedAt    DateTime?

  subtotal Decimal @default(0) @db.Decimal(18, 2)
  taxTotal Decimal @default(0) @db.Decimal(18, 2)
  total    Decimal @default(0) @db.Decimal(18, 2)

  lines     POLine[]
  receipts  GoodsReceipt[]
  createdAt DateTime       @default(now())

  @@index([supplierId])
}

model POLine {
  id        String        @id @default(cuid())
  orderId   String
  order     PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product       @relation(fields: [productId], references: [id])

  quantity         Decimal @db.Decimal(18, 4)
  receivedQuantity Decimal @default(0) @db.Decimal(18, 4)
  unitCost         Decimal @db.Decimal(18, 4)

  grLines   GRLine[]
  createdAt DateTime @default(now())

  @@index([orderId])
}

/// Physical reception, decoupled from the purchase invoice. Updates stock and
/// generates IN movements. Supports partial & multiple receipts per PO.
model GoodsReceipt {
  id           String         @id @default(cuid())
  number       String         @unique
  orderId      String?
  order        PurchaseOrder? @relation(fields: [orderId], references: [id])
  warehouseId  String
  receivedAt   DateTime
  receivedById String?
  notes        String?
  evidenceUrl  String?

  lines     GRLine[]
  createdAt DateTime @default(now())

  @@index([orderId])
}

model GRLine {
  id        String       @id @default(cuid())
  receiptId String
  receipt   GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  poLineId  String?
  poLine    POLine?      @relation(fields: [poLineId], references: [id])
  productId String
  product   Product      @relation(fields: [productId], references: [id])

  quantity  Decimal          @db.Decimal(18, 4) // recibido conforme
  unitCost  Decimal          @db.Decimal(18, 4)
  condition ReceiptCondition @default(OK)
  notes     String?
  createdAt DateTime         @default(now())

  @@index([receiptId])
}

// ============================================================================
//  INVENTORY — ADJUSTMENTS
// ============================================================================

/// Header for a manual adjustment. Each one resolves into IN/OUT movements + kardex.
model InventoryAdjustment {
  id            String           @id @default(cuid())
  number        String           @unique
  warehouseId   String
  reason        AdjustmentReason
  status        FlowStatus       @default(DRAFT)
  responsibleId String?
  approvedById  String?
  evidenceUrl   String?
  notes         String?
  date          DateTime
  createdAt     DateTime         @default(now())
}

// ============================================================================
//  INVENTORY — REORDER RULES & ASSET CUSTODY
// ============================================================================

model ReorderRule {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId  String
  minQty       Decimal  @db.Decimal(18, 4) // stock mínimo
  maxQty       Decimal  @db.Decimal(18, 4) // stock máximo
  reorderPoint Decimal  @db.Decimal(18, 4) // punto de reorden
  createdAt    DateTime @default(now())

  @@unique([productId, warehouseId])
}

/// Tipo de alerta de inventario que levanta el motor.
enum InventoryAlertType {
  LOW_STOCK // existencias en/por debajo del punto de reorden o mínimo
  OUT_OF_STOCK // existencias en cero
  MAINTENANCE_DUE // mantenimiento preventivo próximo a vencer / vencido
}

/// Notificación de inventario (stock bajo, agotado). Espeja el
/// patrón de SstNotification: una fila por (tipo, entidad, ventana) vía dedupeKey,
/// in-app + seams de salida (email/WhatsApp). Reutiliza AlertChannel/AlertStatus.
model InventoryNotification {
  id          String             @id @default(cuid())
  type        InventoryAlertType
  channel     AlertChannel       @default(IN_APP)
  status      AlertStatus        @default(PENDIENTE)
  title       String
  message     String
  productId   String?
  warehouseId String?
  entityType  String?
  entityId    String?
  sentAt      DateTime?
  readAt      DateTime?
  createdAt   DateTime           @default(now())

  // Idempotencia del motor: una alerta por (tipo, entidad, ventana).
  dedupeKey String @unique

  @@index([status])
  @@index([type])
}

/// Estado de una asignación de material a un funcionario.
enum MaterialAssignmentStatus {
  ASSIGNED // entregado / en poder del funcionario
  RETURNED // devuelto (reingresa a stock)
  CONSUMED // consumido (no se devuelve)
  LOST // perdido / no recuperado
}

/// Naturaleza del material entregado, define el tratamiento contable:
/// - CONSUMABLE: se gasta al entregar (sale del stock como consumo).
/// - TOOL: herramienta/activo durable; NO se expensa al entregar (sigue siendo
///   activo en custodia del empleado). Solo se da de baja (gasto) si se pierde o
///   consume; al devolver simplemente se cierra la custodia.
enum MaterialAssignmentKind {
  CONSUMABLE
  TOOL
}

/// Asignación de material (por cantidad) a un funcionario, con custodia y
/// devolución. Al entregar desde una bodega descuenta stock vía Kardex
/// (movimiento OUT, INTERNAL_CONSUMPTION) y al devolver lo reingresa
/// (movimiento IN, RETURN). El inventario sigue siendo la única fuente de verdad.
model MaterialAssignment {
  id               String                   @id @default(cuid())
  employeeId       String
  employee         Employee                 @relation(fields: [employeeId], references: [id])
  productId        String
  product          Product                  @relation(fields: [productId], references: [id])
  warehouseId      String? // bodega de la que sale (y a la que regresa) el material
  quantity         Decimal                  @default(1) @db.Decimal(18, 4)
  returnedQuantity Decimal                  @default(0) @db.Decimal(18, 4) // acumulado devuelto (soporta devolución parcial)
  kind             MaterialAssignmentKind   @default(CONSUMABLE)
  assignedAt       DateTime
  returnedAt       DateTime?
  status           MaterialAssignmentStatus @default(ASSIGNED)
  outMovementId    String? // InventoryMovement OUT generado al entregar
  inMovementId     String? // InventoryMovement IN generado al devolver
  notes            String?
  assignedById     String? // usuario (jefe de bodega) que registró la entrega
  createdAt        DateTime                 @default(now())

  @@index([employeeId])
  @@index([productId])
  @@index([status])
}

/// Custody of tools/assets assigned to employees, with full history of holders.
model AssetAssignment {
  id         String                @id @default(cuid())
  serialId   String
  serial     SerialNumber          @relation(fields: [serialId], references: [id])
  employeeId String // User
  assignedAt DateTime
  returnedAt DateTime?
  status     AssetAssignmentStatus @default(ASSIGNED)
  notes      String?
  createdAt  DateTime              @default(now())

  @@index([serialId])
  @@index([employeeId])
}

// ============================================================================
//  INVENTORY — MAINTENANCE & AREAS (trazabilidad de componentes)
// ============================================================================

enum MaintenanceKind {
  PREVENTIVE // preventivo
  CORRECTIVE // correctivo
}

enum MaintenanceStatus {
  OPEN // abierto / en proceso
  COMPLETED // completado
  CANCELLED // cancelado
}

/// Área / departamento operativo donde se usa o consume el material
/// (ej. Perforación, Taller, Planta). Catálogo para reportar consistente.
model Area {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  maintenances MaintenanceOrder[]
  workOrders   WorkOrder[]
}

/// Orden / registro de mantenimiento sobre un componente.
/// El componente puede ser una unidad con serie (serialId) o un producto
/// genérico sin serie (productId) — al menos uno debe estar presente.
model MaintenanceOrder {
  id     String            @id @default(cuid())
  number String            @unique // MNT-0001
  kind   MaintenanceKind
  status MaintenanceStatus @default(COMPLETED)
  date   DateTime // fecha en que se realizó

  // ---- componente intervenido (serie y/o producto) ----
  serialId  String?
  serial    SerialNumber? @relation(fields: [serialId], references: [id])
  productId String?
  product   Product?      @relation(fields: [productId], references: [id])

  // ---- dónde se usó / quién ----
  areaId String?
  area   Area?   @relation(fields: [areaId], references: [id])

  technician   String? // técnico responsable
  cost         Decimal  @default(0) @db.Decimal(18, 2) // costo de mano de obra / servicio
  meterReading Decimal? @db.Decimal(18, 2) // lectura de horómetro/odómetro del equipo al momento del servicio
  description  String // qué se hizo / falla atendida
  notes        String?
  warehouseId  String? // bodega de donde salieron los repuestos

  parts       MaintenancePart[]
  attachments MaintenanceAttachment[]

  // ---- plan de origen (si nació de un plan preventivo) ----
  planId String?

  // ---- origen ----
  // Si el registro nació al cerrar una orden de trabajo de mantenimiento, queda
  // enlazado a ella (único: una OT genera a lo sumo un registro en la bitácora).
  // Los registros manuales ("express") dejan este campo en null.
  workOrderId String?    @unique
  workOrder   WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: SetNull)

  createdById String?
  createdAt   DateTime @default(now())

  @@index([serialId])
  @@index([productId])
  @@index([areaId])
  @@index([kind])
  @@index([date])
}

/// Repuesto consumido durante un mantenimiento. Descuenta stock vía kardex
/// (movimiento OUT, razón INTERNAL_CONSUMPTION) cuando hay bodega.
model MaintenancePart {
  id            String           @id @default(cuid())
  maintenanceId String
  maintenance   MaintenanceOrder @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)
  productId     String
  product       Product          @relation(fields: [productId], references: [id])
  quantity      Decimal          @db.Decimal(18, 4)
  unitCost      Decimal          @default(0) @db.Decimal(18, 4)
  movementId    String? // movimiento de inventario generado (si descontó stock)
  createdAt     DateTime         @default(now())

  @@index([maintenanceId])
  @@index([productId])
}

/// Adjunto de un mantenimiento (foto del trabajo, factura del repuesto, informe
/// del técnico). El binario vive en disco (uploads/maintenance); aquí van los
/// metadatos. Espeja a WorkOrderPhoto.
model MaintenanceAttachment {
  id            String           @id @default(cuid())
  maintenanceId String
  maintenance   MaintenanceOrder @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)
  fileName      String // nombre original
  storedName    String // nombre en disco (único)
  mimeType      String
  size          Int // bytes
  description   String?
  uploadedById  String?
  createdAt     DateTime         @default(now())

  @@index([maintenanceId])
}

/// Frecuencia de un plan de mantenimiento preventivo: por días calendario o por
/// lectura de horómetro/odómetro del equipo.
enum MaintenanceFrequency {
  BY_DAYS // cada N días calendario
  BY_METER // cada N unidades de horómetro/odómetro (horas, km)
}

/// Plan de mantenimiento preventivo programado para un equipo/área. El cron diario
/// lo evalúa: cuando se acerca/vence el próximo servicio, avisa al responsable
/// (campana + WhatsApp) y, si está configurado, genera automáticamente una orden
/// de trabajo a partir de su plantilla. Usa IDs escalares (sin relaciones FK) para
/// mantenerse autocontenido; el servicio resuelve los nombres.
model MaintenancePlan {
  id     String  @id @default(cuid())
  number String  @unique // MNP-000001
  name   String // nombre del plan (ej. "Cambio de aceite — Bomba 1")
  active Boolean @default(true)

  // ---- equipo objetivo (serie y/o producto y/o área) ----
  serialId  String?
  productId String?
  areaId    String?

  // ---- frecuencia ----
  kind          MaintenanceKind      @default(PREVENTIVE)
  frequency     MaintenanceFrequency @default(BY_DAYS)
  intervalDays  Int? // si BY_DAYS
  intervalMeter Decimal?             @db.Decimal(18, 2) // si BY_METER
  leadDays      Int                  @default(7) // días de anticipación del aviso

  // ---- estado del ciclo ----
  lastServiceDate  DateTime?
  lastServiceMeter Decimal?  @db.Decimal(18, 2)
  nextDueDate      DateTime?
  nextDueMeter     Decimal?  @db.Decimal(18, 2)

  // ---- responsable + plantilla para la OT generada ----
  assigneeId          String? // técnico con login
  assignedEmployeeId  String? // responsable sin login
  warehouseId         String?
  priority            WorkOrderPriority @default(MEDIUM)
  autoCreateWorkOrder Boolean           @default(true)
  taskTemplate        String[] // títulos del checklist para la OT
  notes               String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
  @@index([nextDueDate])
  @@index([serialId])
  @@index([productId])
}

// ============================================================================
//  INVENTORY — WORK ORDERS (órdenes de trabajo)
//  El Jefe de bodega crea y asigna; el Técnico de mantenimiento ejecuta solo
//  las suyas (cambia estado y consume repuestos contra su orden).
// ============================================================================

enum WorkOrderStatus {
  PENDING // creada, sin iniciar
  IN_PROGRESS // en ejecución
  COMPLETED // terminada
  CANCELLED // cancelada
}

enum WorkOrderPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum WorkOrderType {
  CORRECTIVE // correctivo (reparación de falla)
  PREVENTIVE // preventivo (mantenimiento programado)
  INSTALLATION // instalación / montaje
  CLEANING // limpieza / aseo
  INSPECTION // inspección / revisión
  OTHER // otra
}

/// Tipos de evento registrados en la bitácora de auditoría de una orden.
enum WorkOrderEventType {
  CREATED // se creó la orden
  UPDATED // se editaron sus datos
  STARTED // pasó a En progreso
  COMPLETED // se terminó
  CANCELLED // se canceló
  REOPENED // se reabrió una orden cerrada (admin)
  STATUS_FORCED // un admin forzó un cambio de estado fuera del flujo
  PART_ADDED // se consumió un repuesto
  PHOTO_ADDED // se subió evidencia fotográfica
  PHOTO_DELETED // se eliminó una foto
  TASK_DONE // se completó una tarea del checklist
  TASK_UNDONE // se desmarcó una tarea del checklist
}

/// Orden de trabajo genérica: una tarea que el Jefe asigna a un Técnico
/// (surtir, organizar, reparar, mover, etc.). No está atada a mantenimiento.
model WorkOrder {
  id          String            @id @default(cuid())
  number      String            @unique // OT-000001
  title       String
  description String?
  type        WorkOrderType     @default(CORRECTIVE)
  priority    WorkOrderPriority @default(MEDIUM)
  status      WorkOrderStatus   @default(PENDING)

  // ---- dónde / contra qué bodega se consume ----
  areaId      String?
  area        Area?   @relation(fields: [areaId], references: [id])
  warehouseId String? // bodega de donde salen los repuestos al cerrar

  // ---- quién ----
  assigneeId         String? // técnico responsable de ejecutarla (usuario con login)
  assignee           User?     @relation("WorkOrderAssignee", fields: [assigneeId], references: [id])
  // Responsable que NO requiere login: cualquier empleado de RRHH.
  assignedEmployeeId String?
  assignedEmployee   Employee? @relation("WorkOrderEmployee", fields: [assignedEmployeeId], references: [id])
  createdById        String? // jefe que la creó
  createdBy          User?     @relation("WorkOrderCreatedBy", fields: [createdById], references: [id])

  // ---- ciclo de vida ----
  dueDate     DateTime? // fecha límite
  startedAt   DateTime? // cuándo el técnico la inició
  completedAt DateTime? // cuándo se terminó
  resolution  String? // notas de cierre del técnico

  parts  WorkOrderPart[]
  tasks  WorkOrderTask[]
  photos WorkOrderPhoto[]
  events WorkOrderEvent[]

  // Registro generado en la bitácora de Mantenimiento al cerrar la orden, cuando
  // su tipo es preventivo o correctivo (1:1).
  maintenance MaintenanceOrder?

  // Plan de mantenimiento preventivo que la generó (si vino de un plan). Escalar:
  // al cerrarse la OT, el servicio avanza el ciclo del plan.
  planId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assigneeId])
  @@index([assignedEmployeeId])
  @@index([status])
  @@index([areaId])
  @@index([priority])
  @@index([type])
}

/// Ítem de checklist de una orden de trabajo. El Jefe define las tareas al
/// crear la orden; el Técnico las va marcando como hechas durante la ejecución.
model WorkOrderTask {
  id          String    @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  title       String
  done        Boolean   @default(false)
  doneAt      DateTime? // cuándo se marcó como hecha
  position    Int       @default(0) // orden de aparición en la lista
  createdAt   DateTime  @default(now())

  @@index([workOrderId])
}

/// Evidencia fotográfica de una orden de trabajo (antes / durante / después).
/// El binario vive en disco (uploads/work-orders); aquí solo van los metadatos.
model WorkOrderPhoto {
  id           String    @id @default(cuid())
  workOrderId  String
  workOrder    WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  fileName     String // nombre original del archivo
  storedName   String // nombre en disco (único)
  mimeType     String
  size         Int // bytes
  description  String?
  uploadedById String? // usuario que la subió
  createdAt    DateTime  @default(now())

  @@index([workOrderId])
}

/// Repuesto consumido al ejecutar una orden de trabajo. Descuenta stock vía
/// kardex (movimiento OUT, razón INTERNAL_CONSUMPTION) cuando hay bodega.
model WorkOrderPart {
  id          String    @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  quantity    Decimal   @db.Decimal(18, 4)
  unitCost    Decimal   @default(0) @db.Decimal(18, 4)
  movementId  String? // movimiento de inventario generado (si descontó stock)
  createdAt   DateTime  @default(now())

  @@index([workOrderId])
  @@index([productId])
}

/// Bitácora de auditoría de una orden de trabajo: un registro inmutable por cada
/// acción (crear, iniciar, subir foto, consumir repuesto, terminar, etc.) con
/// quién la hizo y cuándo. `actorName` es una instantánea para sobrevivir si el
/// usuario se elimina; `meta` guarda detalles estructurados del evento.
model WorkOrderEvent {
  id          String             @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder          @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  type        WorkOrderEventType
  message     String // resumen legible (es-CO)
  meta        Json? // detalles estructurados ({ from, to }, { productName, quantity }, …)
  actorId     String? // usuario que ejecutó la acción (sin FK: es un registro histórico)
