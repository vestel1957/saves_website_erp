// ============================================================================
//  PAYROLL — NÓMINA INTELIGENTE
//  Lógica operativa de RRHH/Nómina, desacoplada de lo fiscal/contable.
//  El cálculo NO está hardcodeado: cada PayrollConcept describe CÓMO se calcula
//  (calcMethod + rate + base), de modo que las reglas viven en datos, no en código.
// ============================================================================

/// Naturaleza contable del concepto: suma (devengado) o resta (deducción).
enum PayrollConceptType {
  EARNING // devengado
  DEDUCTION // deducción
}

/// Si el concepto constituye salario (afecta prestaciones) o no.
enum PayrollSalaryNature {
  SALARIAL
  NON_SALARIAL
}

/// Familia funcional del concepto (para agrupar/reportar).
enum PayrollConceptCategory {
  BASIC_SALARY
  OVERTIME
  BONUS
  ALLOWANCE
  COMMISSION
  VACATION
  SICK_LEAVE
  PENSION
  HEALTH
  TAX
  OTHER
}

/// Estrategia de cálculo que aplica el motor para este concepto.
enum PayrollCalcMethod {
  FIXED // valor fijo (amount de la novedad o `rate` como monto)
  PERCENTAGE // `rate` (0..1) aplicado sobre `base`
  PER_QUANTITY // cantidad × valor unitario (`rate` = unitario, o unitario de la novedad)
  PROPORTIONAL // prima causada: (salario/30) × `rate` días × (díasLaborados / cycleDays)
}

/// Base de cálculo para conceptos PERCENTAGE / PER_QUANTITY.
enum PayrollCalcBase {
  NONE
  BASIC_SALARY // salario base del contrato (hora ordinaria = salario/monthlyHours)
  DAILY_SALARY // salario diario (salario/divisor: 30 o días reales del mes según clase)
  GROSS_SALARIAL // total devengado de naturaleza salarial
  IBC // ingreso base de cotización (devengado salarial)
}

/// Clase de pago del trabajador. Gobierna el divisor diario.
enum PayrollPayClass {
  QUINCENAL // mes legal de 30 días (norma colombiana)
  QUINCENAL_ROLL // días reales del mes (28/30/31)
}

enum PayrollContractType {
  INDEFINITE // término indefinido
  FIXED_TERM // término fijo
  WORK_LABOR // obra o labor
  SERVICES // prestación de servicios
  APPRENTICESHIP // aprendizaje
}

enum PayrollPeriodStatus {
  OPEN // admite novedades / borradores
  PROCESSING // en cálculo
  CLOSED // liquidado y cerrado (inmutable)
}

enum PayrollEventType {
  VACATION
  SICK_LEAVE
  LICENSE
  PERMISSION
  ABSENCE
  BONUS
  COMMISSION
  ALLOWANCE
  DEDUCTION
  OTHER
}

enum PayrollEventStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PayslipStatus {
  DRAFT // calculado, editable
  ISSUED // emitido al empleado
  PAID // pagado
}

/// Concepto salarial/no salarial configurable. El núcleo de "no hardcodear".
model PayrollConcept {
  id           String                 @id @default(cuid())
  code         String                 @unique // ej. HED, RECN, AUXT
  name         String
  description  String?
  type         PayrollConceptType
  salaryNature PayrollSalaryNature    @default(SALARIAL)
  category     PayrollConceptCategory @default(OTHER)

  // --- cómo se calcula ---
  calcMethod PayrollCalcMethod @default(FIXED)
  rate       Decimal?          @db.Decimal(18, 6) // % (0..1), valor unitario, multiplicador o días de salario
  base       PayrollCalcBase   @default(NONE)
  // Se aplica automáticamente cada periodo sin novedad (ej. Prima de Habitación).
  autoApply  Boolean           @default(false)
  // Días del ciclo para conceptos PROPORTIONAL (semestral 180, anual 360).
  cycleDays  Int?

  // --- incidencia en bases prestacionales (informativo/reportería) ---
  affectsHealth      Boolean @default(false)
  affectsPension     Boolean @default(false)
  affectsParafiscals Boolean @default(false)
  affectsSeverance   Boolean @default(false) // cesantías
  affectsVacation    Boolean @default(false)
  affectsBonus       Boolean @default(false) // prima

  active Boolean @default(true)

  events PayrollEvent[]
  lines  PayslipLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([category])
}

/// Contrato laboral vinculado al Employee canónico (RRHH/SST/Nómina comparten persona).
model PayrollContract {
  id                 String              @id @default(cuid())
  employeeId         String
  employee           Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  contractType       PayrollContractType @default(INDEFINITE)
  // Clase de pago: gobierna el divisor diario (30 vs días reales del mes).
  payClass           PayrollPayClass     @default(QUINCENAL)
  baseSalary         Decimal             @db.Decimal(18, 2)
  // Jornada mensual de referencia para valorar la hora ordinaria (Colombia: 240).
  monthlyHours       Decimal             @default(240) @db.Decimal(10, 2)
  // ¿Tiene derecho a auxilio de transporte? (se materializa vía concepto al liquidar)
  transportAllowance Boolean             @default(true)
  startDate          DateTime
  endDate            DateTime?
  active             Boolean             @default(true)
  notes              String?

  payslips Payslip[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([active])
}

/// Periodo de nómina (quincenal/mensual). Gobierna el estado del cálculo.
model PayrollPeriod {
  id        String              @id @default(cuid())
  name      String // ej. "Junio 2026 - 2da quincena"
  startDate DateTime
  endDate   DateTime
  payday    DateTime?
  status    PayrollPeriodStatus @default(OPEN)

  events   PayrollEvent[]
  payslips Payslip[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

/// Novedad de nómina: vacaciones, incapacidad, bono, comisión, deducción, etc.
/// Es la entrada manual que alimenta el motor (las horas extras llegan por su
/// propio módulo en una fase posterior; aquí caben como novedad si se requiere).
model PayrollEvent {
  id           String             @id @default(cuid())
  employeeId   String
  employee     Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  conceptId    String?
  concept      PayrollConcept?    @relation(fields: [conceptId], references: [id])
  periodId     String?
  period       PayrollPeriod?     @relation(fields: [periodId], references: [id])
  type         PayrollEventType
  startDate    DateTime
  endDate      DateTime?
  quantity     Decimal?           @db.Decimal(12, 2) // días, horas, unidades
  amount       Decimal?           @db.Decimal(18, 2) // monto fijo, si aplica
  notes        String?
  status       PayrollEventStatus @default(PENDING)
  approvedById String?
  approvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([periodId])
  @@index([status])
}

/// Desprendible (colilla) de un empleado en un periodo. Una fila por persona/periodo.
model Payslip {
  id         String           @id @default(cuid())
  periodId   String
  period     PayrollPeriod    @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee         @relation(fields: [employeeId], references: [id])
  contractId String?
  contract   PayrollContract? @relation(fields: [contractId], references: [id])

  // snapshot + totales (todo persistido para inmutabilidad al cerrar)
  baseSalary      Decimal @default(0) @db.Decimal(18, 2)
  grossSalary     Decimal @default(0) @db.Decimal(18, 2) // base + devengado salarial
  totalEarnings   Decimal @default(0) @db.Decimal(18, 2)
  totalDeductions Decimal @default(0) @db.Decimal(18, 2)
  netSalary       Decimal @default(0) @db.Decimal(18, 2)

  status   PayslipStatus @default(DRAFT)
  issuedAt DateTime?

  lines PayslipLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([periodId, employeeId])
  @@index([employeeId])
}

/// Línea de desprendible: el desglose transparente. Cada valor lleva su origen,
/// fórmula legible, cantidad, valor unitario y total para que el empleado lo entienda.
model PayslipLine {
  id        String          @id @default(cuid())
  payslipId String
  payslip   Payslip         @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  conceptId String?
  concept   PayrollConcept? @relation(fields: [conceptId], references: [id])

  type         PayrollConceptType
  salaryNature PayrollSalaryNature    @default(SALARIAL)
  category     PayrollConceptCategory @default(OTHER)

  label     String // nombre mostrado (ej. "Hora Extra Diurna")
  origin    String? // de dónde sale (ej. "Novedad aprobada", "Contrato", "Cálculo automático")
  formula   String? // fórmula legible (ej. "12 x $8.500")
  quantity  Decimal? @db.Decimal(12, 2)
  unitValue Decimal? @db.Decimal(18, 2)
  amount    Decimal  @db.Decimal(18, 2) // valor total de la línea
  order     Int      @default(0)

  createdAt DateTime @default(now())

  @@index([payslipId])
}

// ============================================================================
//  PAYROLL — INTEGRACIONES CONTABLES (Siigo/Alegra/Odoo/…)
//  Registro auditable de cada envío (o dry-run) hacia un proveedor externo.
// ============================================================================

enum IntegrationKind {
  ACCOUNTING_ENTRY // contabilización (asiento)
  ELECTRONIC_PAYROLL // nómina electrónica (DIAN)
  EMPLOYEE_SYNC // sincronización de terceros/empleados
  CONCEPT_SYNC // sincronización de conceptos
}

enum IntegrationStatus {
  OK
  FAILED
  DRY_RUN
}

model AccountingIntegrationLog {
  id          String            @id @default(cuid())
  provider    String // 'siigo' | 'none' | …
  kind        IntegrationKind
  status      IntegrationStatus
  periodId    String?
  payslipId   String?
  reference   String? // id/CUNE devuelto por el proveedor
  message     String?
  request     Json? // payload enviado / que se enviaría
  response    Json? // respuesta cruda del proveedor
  createdById String?
  createdAt   DateTime          @default(now())

  @@index([kind])
  @@index([status])
  @@index([periodId])
}

// ============================================================================
//  MÓDULO ISP — Migración fiel de saves-vestel (Clientes + Facturación)
//  Fuente: legacy CodeIgniter/MariaDB `admin_vestel`. Ver docs de migración.
//  Convención: `legacyId` conserva el PK entero original para el ETL.
//  Dinero: Decimal(18,2) uniforme (legacy usa int COP en invoices y decimal
//  en transactions; se normaliza a Decimal).
// ============================================================================

/// Ciclo de vida del suscriptor. Catálogo real `estados_clientes` (13 estados).
enum SubscriberStatus {
  ACTIVO
  CARTERA
  COMPROMISO
  CORTADO
  DEPURADO
  EVENTO
  EXONERADO
  INSTALAR
  POR_RETIRAR
  REPORTADO
  RETIRADO
  SUSPENDIDO
  INACTIVO
}

/// Estado operativo/gestión de cartera a nivel de FACTURA (`invoices.ron`, 14 valores).
enum InvoiceRon {
  ACTIVO
  INSTALAR
  CORTADO
  SUSPENDIDO
  EXONERADO
  CARTERA
  COMPROMISO
  DEPURADO
  RETIRADO
  ANULADO
  REPORTADO
  EVENTO
  DADO_DE_BAJA
  POR_RETIRAR
}

/// Tipo de servicio contratado por el suscriptor.
enum ServiceKind {
  INTERNET // legacy `invoices.combo`
  TV // legacy `invoices.television`
  PUNTOS // decos/puntos TV adicionales
  STREAMING // add-ons OTT (streaming_*)
}

/// Estado por servicio (`invoices.estado_tv` / `estado_combo`; NULL = activo).
enum ServiceStatus {
  ACTIVO
  CORTADO
  SUSPENDIDO
}

/// Eje de PAGO de la factura (`invoices.status`).
enum SubInvoiceStatus {
  DUE // sin abonos (pamnt = 0)
  PARTIAL // 0 < pamnt < total
  PAID // pamnt >= total
  CANCELED // reservado (legacy casi no lo usa; anulación va por transactions)
}

/// Tipo de factura (`invoices.tipo_factura`).
enum InvoiceKind {
  RECURRENTE
  FIJA
  NOTA_CREDITO
  NOTA_DEBITO
}

/// Tecnología de instalación (`customers.tegnologia_instalacion`) — selecciona Mikrotik.
enum InstallTech {
  GPON
  EPON
  EOC
  RADIO
  FIBRA
}

/// Tipo de movimiento de tesorería (`transactions.type`).
enum TxType {
  INCOME
  EXPENSE
  TRANSFER
}

/// Vigencia de la transacción (`transactions.estado`: NULL = vigente, 'Anulada').
enum TxStatus {
  VIGENTE
  ANULADA
}

/// Retenciones colombianas (`invoices.tipo_retencion`).
enum RetentionType {
  RETEFUENTE_SERVICIOS
  COMPRAS
  PERSONAS_NO_DECLARANTES
  RETEIVA
}

/// Estado de una emisión de factura electrónica (`facturacion_electronica_siigo.tipo`).
enum EInvoiceType {
  FACTURADA
  ERROR
  ACTUALIZADA
  NOTA_CREDITO
}

/// Medio de pago reportado a la DIAN/Siigo.
enum EInvoicePayMethod {
  CREDITO
  EFECTIVO
}

/// Sede / grupo (`customers_group`, gid). Determina Mikrotik y catálogos por ciudad.
model Branch {
  id          String               @id @default(cuid())
  legacyId    Int                  @unique // customers_group.id (gid)
  name        String // title (Yopal, Villanueva, Monterrey, Mocoa, Aguazul, Tauramena, Villavicencio)
  summary     String?
  dir         String?
  subscribers Subscriber[]
  mikrotiks   Mikrotik[]
  olts        Olt[]
  naps        Nap[]
  vlans       Vlan[]
  genieacs    GenieacsConnection[]
  createdAt   DateTime             @default(now())
}

/// Suscriptor / abonado ISP. Núcleo del legacy `customers` (65 cols) normalizado.
/// El estado del servicio y el plan viven además en las facturas (ver SubscriberService).
model Subscriber {
  id          String  @id @default(cuid())
  legacyId    Int?    @unique // customers.id (null = creado en el stack nuevo)
  abonado     Int // código de abonado visible (max(abonado)+1)
  suscripcion String? // número de suscripción/contrato

  // --- Identidad ---
  firstName    String? // name
  secondName   String? // dosnombre
  lastName1    String? // unoapellido
  lastName2    String? // dosapellido
  companyName  String? // company (razón social)
  fullName     String? // cache recompuesto (get_nombre_completo)
  customerType String? // tipo_cliente
  docType      String? // tipo_documento (CC, NIT, ...)
  docNumber    String? // documento
  birthDate    DateTime? @db.Date // nacimiento

  // --- Contacto ---
  phone1 String? // celular
  phone2 String? // celular2
  email  String? // email (legacy trae 'NULL' literal → limpiar en ETL)

  // --- Contrato ---
  contractDate DateTime? @db.Date // f_contrato
  entryDate    DateTime? @db.Date // f_ingreso
  estrato      String?
  clausula     Int? // FK lógica a clausulas

  // --- Dirección (denormalizada: guardan IDs legacy) ---
  departmentRef String? // departamento (id legacy)
  cityRef       String? // ciudad (id legacy)
  localityRef   String? // localidad (id legacy)
  neighborhood  String? // barrio (id legacy)
  addressLine   String? // dirsuscriptor (dirección compuesta)
  nomenclature  Json? // {nomenclatura,numero1,adicionauno,numero2,adicional2,numero3,residencia,referencia,divicion...}
  gpsLat        String? // coor1
  gpsLng        String? // coor2

  // --- Sede ---
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  // --- Red (PPPoE / Mikrotik) ---
  pppUsername String? // name_s (secret PPP; vacío ⇒ sin conectividad)
  pppPassword String? // contra
  pppService  String? // servicio (pppoe...)
  pppProfile  String? // perfil (plan/velocidad en el router)
  ipLocal     String? // Iplocal
  ipRemote    String? // Ipremota
  netComment  String? // comentario del secret
  macEquipo   String? // macequipo (MAC CPE)
  macOnt      String? // mac_ont
  installTech InstallTech? // tegnologia_instalacion

  // --- Estado (cache; la verdad se recompone desde facturas) ---
  status          SubscriberStatus? // usu_estado
  previousStatus  SubscriberStatus? // ultimo_estado
  statusChangedAt DateTime? // fecha_cambio
  statusGenDate   DateTime?         @db.Date // fecha_genera_estado_user
  promiseExpiry   DateTime?         @db.Date // fecha límite del compromiso de pago (protege del corte masivo)

  // --- Dinero (cache recalculado desde transactions) ---
  balance     Decimal @default(0) @db.Decimal(18, 2) // balance (saldo a favor)
  debitCache  Decimal @default(0) @db.Decimal(18, 2) // debit
  creditCache Decimal @default(0) @db.Decimal(18, 2) // credit

  // --- Facturación electrónica (flags) ---
  eInvoice          Boolean            @default(false) // facturar_electronicamente
  eInvoiceTv        Boolean            @default(false) // f_elec_tv
  eInvoiceInternet  Boolean            @default(false) // f_elec_internet
  eInvoicePuntos    Boolean            @default(false) // f_elec_puntos
  digitalSignature  Boolean            @default(false) // firma_digital
  eInvoicePayMethod EInvoicePayMethod? // metodo_pago_f_e

  picture String? // picture

  // --- Enlace contable (cuentas por cobrar) ---
  partyId String?
  party   Party?  @relation(fields: [partyId], references: [id])

  // --- Relaciones ---
  services            SubscriberService[]
  statusHistory       SubscriberStatusHistory[]
  callLogs            CallLog[]
  invoices            SubInvoice[]
  recurringInvoices   RecurringInvoice[]
  projects            Project[]
  transactions        Transaction[]
  electronicInvoices  ElectronicInvoice[]
  oltOnus             OltOnu[]
  ports               Port[]
  equipment           Equipment[]
  tickets             Ticket[]
  ticketThreads       TicketThread[]
  files               SubscriberFile[]
  notes               SubscriberNote[]
  mikrotikLogs        MikrotikActionLog[]
  oltLogs             OltActionLog[]
  playhubSubs         PlayhubSubscription[]
  waMessages          WhatsappMessage[]
  waSends             WhatsappSend[]
  lastEmailReminderAt DateTime? // último recordatorio de cartera por correo (dedupe)
  paymentOrders       PaymentOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([abonado])
  @@index([docNumber])
  @@index([phone1])
  @@index([status])
  @@index([branchId])
  // Búsqueda por texto (ILIKE '%tok%'): índices GIN trigram evitan el seq scan
  // sobre ~21k filas. Requiere la extensión pg_trgm (ya instalada).
  @@index([firstName(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([secondName(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([lastName1(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([lastName2(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([companyName(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([docNumber(ops: raw("gin_trgm_ops"))], type: Gin, map: "Subscriber_docNumber_trgm_idx")
  @@index([phone1(ops: raw("gin_trgm_ops"))], type: Gin, map: "Subscriber_phone1_trgm_idx")
}

/// Auditoría de acciones de red contra el Mikrotik (corte / reconexión / test).
/// Cada intento —real o en dry-run— deja rastro para trazabilidad operativa.
model MikrotikActionLog {
  id           String      @id @default(cuid())
  subscriberId String?
  subscriber   Subscriber? @relation(fields: [subscriberId], references: [id], onDelete: SetNull)
  mikrotikId   String? // Mikrotik.id resuelto
  mikrotikName String? // nombre del router (snapshot)
  action       String // CUT | RECONNECT | STATUS | TEST
  ok           Boolean
  dryRun       Boolean     @default(true)
  detail       String? // resumen de comandos / error
  pppUsername  String? // name_s afectado (snapshot)
  userId       String? // quién lo ejecutó
  userName     String?
  createdAt    DateTime    @default(now())

  @@index([subscriberId])
  @@index([action])
  @@index([createdAt])
}

/// Auditoría de acciones OLT/ONU por SSH (test/aprovisionar/reboot/delete/sync). Espejo de MikrotikActionLog.
model OltActionLog {
  id           String      @id @default(cuid())
  subscriberId String?
  subscriber   Subscriber? @relation(fields: [subscriberId], references: [id], onDelete: SetNull)
  oltId        String? // Olt.id resuelto
  oltName      String? // nombre de la OLT (snapshot)
  action       String // TEST | BOARDS | ONUS | AUTOFIND | PROVISION | REBOOT | DELETE | SYNC | LINK | FIND | DETAIL
  ok           Boolean
  dryRun       Boolean     @default(true)
  detail       String? // resumen de comandos / error
  sn           String? // serial de ONU afectada (snapshot)
  fsp          String? // frame/slot/port(:ontid) afectado (snapshot)
  userId       String? // quién lo ejecutó
  userName     String?
  createdAt    DateTime    @default(now())

  @@index([subscriberId])
  @@index([oltId])
  @@index([action])
  @@index([createdAt])
}

/// Auditoría de acciones GenieACS/TR-069 (test/tag/corte-tv/provision). Espejo de OltActionLog.
model GenieacsActionLog {
  id           String   @id @default(cuid())
  serverId     String? // GenieacsServer.id resuelto
  serverName   String? // nombre del ACS (snapshot)
  action       String // TEST | LIST | TAG_CUT | TAG_RESTORE | REFRESH | SET_PARAM | INSTALL_PROVISION | LINK | DELETE
  ok           Boolean
  dryRun       Boolean  @default(true)
  detail       String? // resumen del plan / error
  deviceId     String? // _id del CPE afectado (snapshot, individual)
  subscriberId String? // vínculo opcional (sin FK: preserva el log si se borra el abonado)
  count        Int? // nº de dispositivos afectados en operaciones masivas
  userId       String? // quién lo ejecutó
  userName     String?
  createdAt    DateTime @default(now())

  @@index([serverId])
  @@index([action])
  @@index([createdAt])
}

/// PlayHub / IPTV — suscripciones de TV por streaming (playhub_suscripciones).
model PlayhubSubscription {
  id           String      @id @default(cuid())
  legacyId     Int?        @unique
  subscriberId String?
  subscriber   Subscriber? @relation(fields: [subscriberId], references: [id], onDelete: SetNull)
  nameS        String? // name_s
  externalName String? // nombre_externo
  productId    String? // product_id (S01…)
  productName  String? // product_name
  voucher      String?
  syncedAt     DateTime? // fecha_sync

  @@index([subscriberId])
}

/// Log de conversaciones WhatsApp (Kapso): mensajes entrantes y salientes.
model WhatsappMessage {
  id           String      @id @default(cuid())
  waMessageId  String? // id del mensaje en el transporte (dedup)
  direction    String // IN | OUT
  phone        String // contraparte en E.164 (sin +)
  body         String      @db.Text
  hasAudio     Boolean     @default(false)
  subscriberId String?
  subscriber   Subscriber? @relation(fields: [subscriberId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())

  @@index([phone])
  @@index([subscriberId])
  @@index([createdAt])
}

enum WhatsappSendStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

/// Plantilla de correo (factura disponible, recordatorio, vencida, recibo).
model EmailTemplate {
  id        String   @id @default(cuid())
  kind      String   @unique // INVOICE_AVAILABLE | REMINDER | OVERDUE | RECEIPT | GENERIC
  name      String
  subject   String
  bodyHtml  String   @db.Text // HTML con {{nombre}} {{abonado}} {{factura}} {{total}} {{vence}} {{deuda}} {{empresa}}
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Plantilla de WhatsApp aprobada en Meta/Kapso (referencia local + mapeo de variables).
model WhatsappTemplate {
  id         String   @id @default(cuid())
  name       String   @unique // nombre exacto aprobado en Meta
  language   String   @default("es") // code: es, es_CO, en
  category   String? // MARKETING | UTILITY | AUTHENTICATION
  bodyText   String   @db.Text // texto con {{1}} {{2}} para previsualizar/renderizar
  headerText String?
  /// [{ index: 1, label: "Nombre", source: "name|abonado|deuda|plan|custom", value?: "..." }]
  variables  Json?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  campaigns WhatsappCampaign[]

  @@index([active])
}

/// Campaña de envío masivo por plantilla.
model WhatsappCampaign {
  id            String            @id @default(cuid())
  name          String
  templateId    String?
  template      WhatsappTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateName  String // snapshot del nombre usado
  language      String            @default("es")
  filterJson    Json? // filtro de clientes usado (auditoría)
  total         Int               @default(0)
  sent          Int               @default(0)
  delivered     Int               @default(0)
  read          Int               @default(0)
  failed        Int               @default(0)
  status        String            @default("running") // running | done | error
  createdByName String?
  createdAt     DateTime          @default(now())
  finishedAt    DateTime?

  sends WhatsappSend[]

  @@index([createdAt])
  @@index([templateId])
}

/// Envío individual dentro de una campaña (o suelto por plantilla). Trackea el estado.
model WhatsappSend {
  id           String             @id @default(cuid())
  campaignId   String?
  campaign     WhatsappCampaign?  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  subscriberId String?
  subscriber   Subscriber?        @relation(fields: [subscriberId], references: [id], onDelete: SetNull)
  phone        String // E.164 sin +
  templateName String?
  waMessageId  String?            @unique // id del mensaje en Meta (para casar el status del webhook)
  status       WhatsappSendStatus @default(QUEUED)
  error        String?
  body         String?            @db.Text // texto renderizado (auditoría)
  sentAt       DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([campaignId])
  @@index([status])
  @@index([subscriberId])
}

/// Móvil / cuadrilla: agrupa técnicos para asignar órdenes y eventos (tabla `moviles`).
model Movil {
  id            String        @id @default(cuid())
  legacyId      Int?          @unique // id_movil
  name          String?
  status        String        @default("Activa") // Activa | Inactiva
  createdByName String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  members       MovilMember[]

  @@index([status])
}

/// Técnico asignado a una móvil (tabla `empleados_moviles`).
model MovilMember {
  id         String   @id @default(cuid())
  legacyId   Int?     @unique // id_empleados_moviles
  movilId    String
  movil      Movil    @relation(fields: [movilId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  role       String? // rol

  @@unique([movilId, employeeId])
  @@index([employeeId])
}

/// Mensajería interna / bitácora de mensajes (tabla `mensajes`).
model InternalMessage {
  id              String   @id @default(cuid())
  legacyId        Int?     @unique
  campaignName    String? // nombre_cam
  refId           Int? // ide
  recipientUserId Int? // iduser
  body            String   @db.Text // sms
  createdAt       DateTime @default(now())

  @@index([recipientUserId])
}

/// Gestor documental — carpetas (folders).
model DocFolder {
  id        String     @id @default(cuid())
  legacyId  Int?       @unique
  name      String
  createdAt DateTime   @default(now())
  documents Document[]
}

/// Gestor documental — documentos (documents). Binarios nuevos en disco.
model Document {
  id         String     @id @default(cuid())
  legacyId   Int?       @unique
  folderId   String?
  folder     DocFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  title      String
  fileName   String? // filename original
  storedName String? // uuid+ext en disco (subidos por la app)
  docDate    DateTime?  @db.Date // cdate
  permission Int        @default(0)
  createdAt  DateTime   @default(now())

  @@index([folderId])
}

/// Auditoría de ejecuciones de cronjobs (programadas o manuales).
model CronRun {
  id         String    @id @default(cuid())
  job        String // RECURRING_BILLING | CARTERA | EXCHANGE_RATE
  ok         Boolean
  manual     Boolean   @default(false) // disparo manual vs programado
  detail     String?
  count      Int       @default(0)
  userName   String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([job, startedAt])
}

/// Servicio contratado (normaliza combo/television/puntos que el legacy guarda en la factura).
model SubscriberService {
  id           String        @id @default(cuid())
  subscriberId String
  subscriber   Subscriber    @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  kind         ServiceKind
  planName     String? // "300 Megas ST", plan TV, etc.
  price        Decimal?      @db.Decimal(18, 2)
  taxRate      Decimal       @default(0) @db.Decimal(9, 2) // IVA% de la mensualidad (TV=19, internet=0)
  status       ServiceStatus @default(ACTIVO)
  megas        Int? // parseado del plan (regex) para elegibilidad PlayHub
  planId       String? // plan del catálogo del que se copió name+price (si aplica)
  plan         Plan?         @relation(fields: [planId], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([subscriberId])
  @@index([kind])
  @@index([planId])
}

/// Catálogo de planes de servicio (internet/TV). Es la ÚNICA fuente de precio de
/// la mensualidad recurrente: al asignar un plan a un abonado se copian name+price
/// al SubscriberService (snapshot) y el perfil PPP se empuja al router (Mikrotik).
/// Cambiar el precio del catálogo NO reprecia facturas ya emitidas.
model Plan {
  id         String      @id @default(cuid())
  name       String // "300 Megas ST"
  kind       ServiceKind @default(INTERNET)
  pppProfile String? // perfil/velocidad en el router (Mikrotik). null = no empuja al router.
  price      Decimal     @default(0) @db.Decimal(18, 2)
  taxRate    Decimal     @default(0) @db.Decimal(9, 2) // IVA% (TV=19, internet=0)
  megas      Int? // velocidad Mbps (informativo / elegibilidad PlayHub)
  active     Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  services SubscriberService[]

  @@index([kind])
  @@index([active])
}

/// Historial de transiciones de estado (legacy tabla `estados`).
model SubscriberStatusHistory {
  id             String           @id @default(cuid())
  subscriberId   String
  subscriber     Subscriber       @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  status         SubscriberStatus
  date           DateTime
  originTicketId Int? // `col` (ticket que disparó el cambio; 2 fijo en paso_cartera)
  note           String?
  createdAt      DateTime         @default(now())

  @@index([subscriberId])
  @@index([date])
  @@index([status, date]) // reportes cortes/activaciones por estado + periodo
}

/// Bitácora de llamadas de cobranza + acuerdos de pago (legacy `llamadas`).
/// Un registro con `responseDetail = 'Acuerdo de Pago'` es un compromiso: su
/// `dueDate` alimenta `Subscriber.promiseExpiry` y protege del corte masivo.
model CallLog {
  id             String     @id @default(cuid())
  legacyId       Int?       @unique // llamadas.id
  subscriberId   String // iduser
  subscriber     Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  callType       String? // tllamada (tipo/canal de la llamada)
  responseType   String? // trespuesta (catálogo libre de respuestas)
  responseDetail String? // drespuesta ('Acuerdo de Pago' | 'Solicitud de descuento' | ...)
  responsible    String? // responsable (cobrador que registró)
  date           DateTime   @db.Date // fcha
  time           String? // hra (HH:mm)
  dueDate        DateTime?  @db.Date // fecha_vence (solo en Acuerdo de Pago)
  notes          String? // notes
  createdAt      DateTime   @default(now())

  @@index([subscriberId])
  @@index([responseDetail])
  @@index([dueDate])
  @@index([responsible])
  @@index([date])
}

/// Factura de suscriptor (legacy `invoices`). Dos ejes de estado: status (pago) y ron (servicio/cartera).
model SubInvoice {
  id       String @id @default(cuid())
  legacyId Int?   @unique // invoices.id (null = creada en el stack nuevo)
  tid      Int    @unique // número de factura (invoices.tid)

  subscriberId String
  subscriber   Subscriber @relation(fields: [subscriberId], references: [id]) // csd
  issuerUserId Int? // eid (aauth_users)

  invoiceDate DateTime @db.Date // invoicedate
  dueDate     DateTime @db.Date // invoiceduedate

  // Montos
  subtotal   Decimal @default(0) @db.Decimal(18, 2)
  shipping   Decimal @default(0) @db.Decimal(18, 2)
  discount   Decimal @default(0) @db.Decimal(18, 2)
  tax        Decimal @default(0) @db.Decimal(18, 2)
  total      Decimal @default(0) @db.Decimal(18, 2)
  paidAmount Decimal @default(0) @db.Decimal(18, 2) // pamnt (saldo = total - paidAmount)

  status SubInvoiceStatus @default(DUE) // eje de pago
  ron    InvoiceRon? // eje de servicio/gestión

  paymentMethod  String? // pmethod (último abono)
  itemsCount     Int     @default(0) // items
  taxEnabled     Boolean @default(true) // taxstatus
  discEnabled    Boolean @default(false) // discstatus
  discountFormat String? // format_discount ('%','flat','b_p','bflat')
  branchRef      String? // refer (sede de la factura)

  // Servicios facturados (snapshot en la factura, tal como el legacy)
  serviceTv            String? // television (plan TV; "no" = sin TV)
  serviceCombo         String? // combo (plan internet)
  puntos               Int? // puntos TV
  estadoTv             ServiceStatus? // estado_tv
  estadoCombo          ServiceStatus? // estado_combo
  streamingStandard    Int            @default(0)
  streamingPremium     Int            @default(0)
  streamingPremiumPlus Int            @default(0)
  streamingDiamante    Int            @default(0)

  term          Int? // billing_terms.id
  rec           String? // periodicidad heredada ("1 month")
  reconnectFlag Boolean     @default(false) // rec (flag reconexión pendiente '0'/'1')
  currencyRef   Int? // multi
  kind          InvoiceKind @default(RECURRENTE) // tipo_factura

  // Promos (contadores de meses, no prorrateo)
  promo              Int?
  promo2             Int?
  promoModifiedDate  DateTime? @db.Date
  promo2ModifiedDate DateTime? @db.Date

  retentionType RetentionType? // tipo_retencion

  // Facturación electrónica (flags en la factura)
  eInvoiceFlag      String? // facturacion_electronica ('Crear Factura Electronica'|'Factura Electronica Creada')
  eInvoiceGenDate   DateTime?          @db.Date // fecha_f_electronica_generada
  eInvoiceServices  String? // servicios_facturados_electronicamente
  eInvoicePayMethod EInvoicePayMethod? // metodo_pago_f_e

  notes String? // notes

  // Relaciones
  items              SubInvoiceItem[]
  transactions       Transaction[]
  additionalServices AdditionalService[]
  receipts           PaymentReceipt[]
  electronicInvoices ElectronicInvoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subscriberId])
  @@index([status])
  @@index([ron])
  @@index([invoiceDate])
  @@index([dueDate])
  @@index([kind])
  @@index([subscriberId, status]) // listado clientes filtro cuenta=debe/aldia (semi-join): 1043ms -> 2ms
  @@index([status, subscriberId]) // listado clientes filtro deuda (groupBy status): 2019ms -> 32ms
}

/// Ítem de factura (legacy `invoice_items`).
model SubInvoiceItem {
  id              String         @id @default(cuid())
  legacyId        Int?           @unique // invoice_items.id (null = creado en el stack nuevo)
  invoiceId       String
  invoice         SubInvoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade) // tid
  productId       Int? // pid (0 = ítem manual/retención)
  productName     String? // product (snapshot)
  description     String? // product_des
  qty             Int            @default(0)
  price           Decimal        @default(0) @db.Decimal(18, 2)
  taxRate         Decimal        @default(0) @db.Decimal(9, 2) // tax (%)
  discount        Decimal        @default(0) @db.Decimal(18, 2)
  subtotal        Decimal        @default(0) @db.Decimal(18, 2)
  taxTotal        Decimal        @default(0) @db.Decimal(18, 2) // totaltax
  discountTotal   Decimal        @default(0) @db.Decimal(18, 2) // totaldiscount
  taxRemoved      Int? // tax_removed
  retentionType   RetentionType? // tipo_retencion
  createdByUserId Int? // id_usuario_crea
  createdAt       DateTime       @default(now()) // fecha_creacion

  @@index([invoiceId])
  @@index([productId])
  @@index([productName, createdAt]) // vista Notas crédito/débito: filtra por productName + ordena por createdAt (evita seq scan sobre ~772k filas)
}

/// Servicios adicionales facturados (legacy `servicios_adicionales`, ligado a factura).
model AdditionalService {
  id        String      @id @default(cuid())
  legacyId  Int         @unique
  invoiceId String?
  invoice   SubInvoice? @relation(fields: [invoiceId], references: [id]) // tid_invoice
  ticketId  Int? // idt_ticket
  productId Int // pid
  valor     String // cantidad/valor solicitado ("5 repetidores")
  subtotal  Decimal     @default(0) @db.Decimal(18, 2)
  total     Decimal     @default(0) @db.Decimal(18, 2)
  createdAt DateTime    @default(now())

  @@index([invoiceId])
}

/// Catálogo de categorías de egreso (legacy `transactions_cat`).
model TransactionCategory {
  id       String @id @default(cuid())
  legacyId Int    @unique
  name     String
}

/// Movimiento de tesorería (legacy `transactions`). Pago de factura = Income/Sales.
model Transaction {
  id       String @id @default(cuid())
  legacyId Int?   @unique // transactions.id (null = creada en el stack nuevo)

  cashAccountId Int? // acid (accounts / caja)
  accountName   String? // account
  type          TxType
  category      String // cat ('Sales' para ingresos por venta)
  debit         Decimal @default(0) @db.Decimal(18, 2)
  credit        Decimal @default(0) @db.Decimal(18, 2)

  payerName    String? // payer
  subscriberId String?
  subscriber   Subscriber? @relation(fields: [subscriberId], references: [id]) // payerid

  method String? // method (Cash/Bank/Balance)
  date   DateTime @db.Date

  invoiceId String?
  invoice   SubInvoice? @relation(fields: [invoiceId], references: [id]) // tid (0 = sin factura)

  issuerUserId Int? // eid
  note         String?
  ext          Boolean  @default(false) // 0 venta / 1 compra-gasto
  bankName     String? // nombre_banco
  bankId       Int? // id_banco
  status       TxStatus @default(VIGENTE) // estado (NULL vigente / 'Anulada')
  noShow       Boolean  @default(false) // no_mostrar
  payuOrderId  String? // id_orden_payu
  attach       String? // comprobante/evidencia: nombre almacenado (uuid.ext) en uploads/treasury
  attachName   String? // nombre original del archivo subido

  // Enlaces a compras/devoluciones/proveedor (para pagos y estado de cuenta del proveedor)
  supplyOrderId String? // pago/abono a una orden de compra
  stockReturnId String? // pago/abono a una devolución
  supplierId    String? // proveedor (pago directo o derivado de la orden/devolución)

  receiptLinks ReceiptTransaction[]
  voiding      Voiding?

  createdAt DateTime @default(now())

  @@index([subscriberId, status, ext])
  @@index([invoiceId])
  @@index([category])
  @@index([date])
  @@index([type, date])
  @@index([supplierId])
  @@index([supplyOrderId])
  @@index([stockReturnId])
}

/// Recibo de pago (legacy `recibos_de_pago`). Agrupa 1..N transacciones (M:N).
model PaymentReceipt {
  id           String               @id @default(cuid())
  legacyId     Int?                 @unique
  date         DateTime // date
  fileName     String // file_name
  invoiceId    String?
  invoice      SubInvoice?          @relation(fields: [invoiceId], references: [id]) // tid (factura principal)
  transactions ReceiptTransaction[]
  createdAt    DateTime             @default(now())

  @@index([invoiceId])
  @@index([date])
}

/// Puente M:N recibo ↔ transacción (legacy `transactions_ids_recibos_de_pago`).
model ReceiptTransaction {
  id            String         @id @default(cuid())
  receiptId     String
  receipt       PaymentReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  transactionId String
  transaction   Transaction    @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([receiptId, transactionId])
  @@index([transactionId])
}

/// Anulación de una transacción (legacy `anulaciones`). Soft-delete: la tx queda 'Anulada'.
model Voiding {
  id            String      @id @default(cuid())
  legacyId      Int?        @unique
  dateTime      DateTime // fecha_hora
  detail        String? // detalle
  transactionId String      @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  reason        String // razon_anulacion
  voidedBy      String // usuario_anula
  createdAt     DateTime    @default(now())
}

/// OBSOLETO (2026-07-17) — ya no se escribe ni se lee. NO USAR.
///
/// El comentario anterior afirmaba que "el legacy no tiene cierre de caja". Es FALSO: sí
/// lo tiene y corre a diario en producción, sólo que no usa la tabla `cierres_caja` (esa
/// sí está muerta, con 3 filas de prueba del 30-dic-2025) ni la palabra "arqueo". Vive en
/// `Reports.php::sacar_pdf()` y materializa el cierre como DOS transacciones
/// `Saldo <fecha>` — el arrastre es un movimiento del libro, no un campo. Ver
/// `src/treasury/cierre-legacy.ts`.
///
/// Este modelo era un diseño propio (fondo fijo, arrastre en `surplus`, consignado) que
/// no correspondía al legacy y además contaba el arrastre dos veces: la fila
/// `Saldo <ayer>` YA está en el efectivo del día, y encima se sumaba `surplus` del cierre
/// anterior. Se conserva la tabla sólo para no perder las 3 filas migradas; el cierre
/// vive ahora en `Transaction`.
model CashClose {
  id            String   @id @default(cuid())
  legacyId      Int?     @unique
  cashAccountId Int // account_id
  date          DateTime @db.Date // fecha
  base          Decimal  @default(0) @db.Decimal(14, 2)
  sales         Decimal  @default(0) @db.Decimal(14, 2) // ventas (recaudo del día)
  expenses      Decimal  @default(0) @db.Decimal(14, 2) // egresos
  /// Transferencias de otras cajas propias. Van en su PROPIA línea: mover plata de la
  /// caja A a la B no es venta ni gasto, es la misma plata cambiando de cajón. Antes
  /// entraban en `sales` e inflaban el recaudo reportado, y el excedente inflado se
  /// arrastraba al día siguiente vía el arrastre.
  transfersIn   Decimal  @default(0) @db.Decimal(14, 2)
  transfersOut  Decimal  @default(0) @db.Decimal(14, 2)
  deposited     Decimal  @default(0) @db.Decimal(14, 2) // consignado
  /// excedente = arrastre + ventas − egresos + transferencias recibidas − enviadas − consignado
  surplus       Decimal  @default(0) @db.Decimal(14, 2)
  userId        Int // usuario_id
  createdAt     DateTime @default(now())

  @@unique([cashAccountId, date])
}

/// Plantilla de factura recurrente ("Reciclaje de ventas", legacy `rec_invoices`).
model RecurringInvoice {
  id           String                 @id @default(cuid())
  legacyId     Int?                   @unique
  tid          Int                    @unique
  subscriberId String
  subscriber   Subscriber             @relation(fields: [subscriberId], references: [id])
  invoiceDate  DateTime?              @db.Date
  dueDate      DateTime?              @db.Date // próxima generación
  subtotal     Decimal                @default(0) @db.Decimal(18, 2)
  shipping     Decimal                @default(0) @db.Decimal(18, 2)
  discount     Decimal                @default(0) @db.Decimal(18, 2)
  tax          Decimal                @default(0) @db.Decimal(18, 2)
  total        Decimal                @default(0) @db.Decimal(18, 2)
  status       String? // legacy status (paid/due/...)
  ron          String? // legacy ron ('Recurring')
  term         Int? // billing_terms.id
  rec          String? // periodicidad ('1 day', '1 month')
  notes        String?
  itemsCount   Int                    @default(0)
  branchRef    String?
  active       Boolean                @default(true)
  items        RecurringInvoiceItem[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([subscriberId])
}

/// Ítem de plantilla recurrente (legacy `rec_invoice_items`).
model RecurringInvoiceItem {
  id            String           @id @default(cuid())
  legacyId      Int?             @unique
  invoiceId     String
  invoice       RecurringInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId     Int?
  productName   String?
  description   String?
  qty           Int              @default(0)
  price         Decimal          @default(0) @db.Decimal(18, 2)
  taxRate       Decimal          @default(0) @db.Decimal(9, 2)
  subtotal      Decimal          @default(0) @db.Decimal(18, 2)
  taxTotal      Decimal          @default(0) @db.Decimal(18, 2)
  discountTotal Decimal          @default(0) @db.Decimal(18, 2)
  createdAt     DateTime         @default(now())

  @@index([invoiceId])
}

/// Apertura de caja diaria por cuenta (base inicial). Complementa CashClose.
model CashOpen {
  id            String   @id @default(cuid())
  cashAccountId Int
  accountName   String?
  date          DateTime @db.Date
  base          Decimal  @default(0) @db.Decimal(14, 2) // base inicial de efectivo
  note          String?
  openedBy      String? // nombre del usuario que abre
  openedAt      DateTime @default(now())

  @@unique([cashAccountId, date])
}

// ===== Configuración: cajas, geografía, empresa =====

/// Caja / cuenta bancaria (legacy `accounts`).
model CashAccount {
  id            String  @id @default(cuid())
  legacyId      Int?    @unique
  accountNumber String? // acn
  holder        String // holder (nombre de la caja)
  branchLegacy  Int? // sede (0 = banco)
  balance       Decimal @default(0) @db.Decimal(16, 2) // lastbal
  /// Fondo fijo de la caja: la plata que NUNCA sale del cajón y por eso no entra en
  /// el excedente del arqueo. Estaba hardcodeado en 200.000 para todas, pero de los
  /// 3 únicos cierres reales que existen uno cerró con base de 300.000 → no es una
  /// constante del negocio. Por caja, con 200.000 de default.
  fixedFund     Decimal @default(200000) @db.Decimal(14, 2)
  code          String?
  address       String? // direccion
  phone         String? // telefono
  departmentRef String? // departamento
}

/// Departamento (legacy `departamentos`).
model Department {
  id       String @id @default(cuid())
  legacyId Int?   @unique // idDepartamento
  name     String
}

/// Ciudad (legacy `ciudad`).
model City {
  id               String @id @default(cuid())
  legacyId         Int?   @unique // idCiudad
  departmentLegacy Int? // idDepartamento
  name             String
}

/// Localidad (legacy `localidad`).
model Locality {
  id               String @id @default(cuid())
  legacyId         Int?   @unique // idLocalidad
  departmentLegacy Int?
  cityLegacy       Int?
  name             String
}

/// Barrio (legacy `barrio`).
model Neighborhood {
  id               String @id @default(cuid())
  legacyId         Int?   @unique // idBarrio
  departmentLegacy Int?
  cityLegacy       Int?
  localityLegacy   Int?
  name             String
}

/// Datos de la empresa (legacy `app_system`, fila única).
model CompanyInfo {
  id       String  @id @default(cuid())
  legacyId Int?    @unique
  name     String // cname
  address  String?
  city     String?
  region   String?
  country  String?
  phone    String?
  email    String?
  taxId    String? // taxid
  currency String?
  prefix   String?
  logo     String?
}

// ===== Omnicanalidad / eventos (calendario), cotizaciones =====

/// Evento de calendario / agenda (legacy `events`).
model CalendarEvent {
  id          String    @id @default(cuid())
  legacyId    Int?      @unique
  orderNo     Int? // idorden (ticket.codigo)
  taskId      Int? // id_tarea
  title       String?
  description String?
  color       String?
  start       DateTime?
  end         DateTime?
  allDay      Boolean   @default(false)
  rel         Int? // 1=proyecto
  rid         Int? // id relacionado
  assignedBy  String? // asigno

  @@index([start])
  @@index([orderNo])
}

/// Cotización (legacy `quotes`; estructura como factura, sin datos reales).
model Quote {
  id               String      @id @default(cuid())
  legacyId         Int?        @unique
  tid              Int         @unique
  subscriberId     String?
  subscriberLegacy Int?
  invoiceDate      DateTime?   @db.Date
  dueDate          DateTime?   @db.Date
  subtotal         Decimal     @default(0) @db.Decimal(18, 2)
  discount         Decimal     @default(0) @db.Decimal(18, 2)
  tax              Decimal     @default(0) @db.Decimal(18, 2)
  total            Decimal     @default(0) @db.Decimal(18, 2)
  status           String      @default("pending")
  notes            String?
  proposal         String?
  itemsCount       Int         @default(0)
  items            QuoteItem[]
  createdAt        DateTime    @default(now())

  @@index([subscriberId])
}

model QuoteItem {
  id             String  @id @default(cuid())
  legacyId       Int?    @unique
  quoteId        String
  quote          Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  materialLegacy Int?
  product        String?
  qty            Int     @default(0)
  price          Decimal @default(0) @db.Decimal(18, 2)
  taxRate        Decimal @default(0) @db.Decimal(9, 2)
  subtotal       Decimal @default(0) @db.Decimal(18, 2)
  taxTotal       Decimal @default(0) @db.Decimal(18, 2)

  @@index([quoteId])
}

// ===== RRHH: Empleados (legacy employee_profile + aauth_users) =====

/// Área/departamento del empleado (legacy `areas`).
model StaffArea {
  id          String  @id @default(cuid())
  legacyId    Int?    @unique // ida
  name        String // nombre_area
  description String? // descripcion
  staff       Staff[]
}

/// Empleado / usuario del sistema (legacy `employee_profile` 1:1 con `aauth_users`).
model Staff {
  id         String     @id @default(cuid())
  legacyId   Int?       @unique // employee_profile.id = aauth_users.id
  name       String
  docNumber  String? // dto
  username   String? // aauth_users.username
  email      String? // aauth_users.email
  role       Int? // aauth_users.roleid (2..5)
  entryDate  DateTime?  @db.Date // ingreso
  rh         String? // grupo sanguíneo
  eps        String? // salud
  pension    String? // pensiones
  address    String?
  city       String?
  region     String?
  country    String?
  areaId     String?
  area       StaffArea? @relation(fields: [areaId], references: [id])
  areaLegacy Int?
  phone      String?
  phoneAlt   String? // phonealt
  picture    String?
  sign       String?
  banned     Boolean    @default(false)
  lastLogin  DateTime?
  sedeAccede String? // CSV de sedes
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  // Promociones que este funcionario tiene autorizadas para aplicar (m2m).
  promotions              Promotion[]              @relation("PromotionAssignees")
  promotionApplications   PromotionApplication[]
  promotionAssignmentLogs PromotionAssignmentLog[] @relation("StaffPromotionAssignmentLogs")

  @@index([role])
  @@index([areaId])
}

// ===== Promociones de facturación (legacy tabla `promos` de settings/promociones) =====

/// Campaña de descuento. El superusuario la crea y la asigna a funcionarios;
/// esos funcionarios pueden aplicar el % a las facturas de los clientes mientras
/// esté vigente. Reemplaza la tabla legacy `promos` (columna `colaborador` JSON).
model Promotion {
  id               String            @id @default(cuid())
  name             String // pro_nombre
  description      String?
  percentage       Int               @default(0) // porcentaje (0..100); usado cuando discountFormat es '%' o 'b_p'
  /// Formato de descuento (fiel al legacy `format_discount`):
  /// '%' = % después de imp. | 'flat' = monto fijo después de imp. |
  /// 'b_p' = % antes de imp. | 'bflat' = monto fijo antes de imp.
  discountFormat   String            @default("%")
  /// Monto fijo del descuento (cuando discountFormat es 'flat' o 'bflat').
  flatAmount       Decimal?          @db.Decimal(18, 2)
  startDate        DateTime          @db.Date // f_inicio
  endDate          DateTime          @db.Date // f_final
  active           Boolean           @default(true)
  /// Global = disponible para todos los funcionarios (legacy `colaborador = null`).
  global           Boolean           @default(false)
  /// Promo POR ESTADO DE CLIENTE (legacy `id_estado_clientes`): si está set, la
  /// promo aplica a las facturas de los clientes en ese estado (no por funcionario).
  subscriberStatus SubscriberStatus?

  /// Funcionarios autorizados a aplicar la promo (legacy `colaborador` JSON de IDs).
  assignees      Staff[]                  @relation("PromotionAssignees")
  applications   PromotionApplication[]
  assignmentLogs PromotionAssignmentLog[]

  createdBy String? // nombre/email del superusuario que la creó
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([startDate, endDate])
  @@index([subscriberStatus])
}

/// Historial de asignaciones de una promoción a funcionarios: qué promo, a quién,
/// quién la asignó y cuándo. Registra tanto altas (ASSIGNED) como bajas
/// (UNASSIGNED). Guarda snapshots de nombre para que el historial sobreviva a
/// renombres/borrados. Se escribe en cada create/update de la promoción.
model PromotionAssignmentLog {
  id             String                @id @default(cuid())
  promotionId    String
  promotion      Promotion             @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  promotionName  String // snapshot del nombre de la promo
  staffId        String? // funcionario (null = entrada "global/todos")
  staff          Staff?                @relation("StaffPromotionAssignmentLogs", fields: [staffId], references: [id])
  staffName      String // snapshot del nombre del funcionario (o "Todos (global)")
  action         PromotionAssignAction
  assignedByName String? // superusuario que hizo el cambio
  createdAt      DateTime              @default(now())

  @@index([promotionId])
  @@index([staffId])
  @@index([createdAt])
}

enum PromotionAssignAction {
  ASSIGNED
  UNASSIGNED
}

/// Registro de una promoción aplicada a una factura (nota crédito). Evita
/// aplicar dos veces la misma promo a la misma factura y deja traza del autor.
model PromotionApplication {
  id            String    @id @default(cuid())
  promotionId   String
  promotion     Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  invoiceId     String // SubInvoice.id
  staffId       String? // funcionario que la aplicó
  staff         Staff?    @relation(fields: [staffId], references: [id])
  appliedByName String? // snapshot del usuario logueado
  percentage    Int // % aplicado (snapshot)
  amount        Decimal   @db.Decimal(18, 2) // monto descontado
  createdAt     DateTime  @default(now())

  @@unique([promotionId, invoiceId])
  @@index([invoiceId])
}

// ===== Proyectos (legacy projects + milestones; tareas via TodoTask.related/rid) =====

/// Proyecto (legacy `projects`).
model Project {
  id               String      @id @default(cuid())
  legacyId         Int?        @unique
  code             String? // p_id
  name             String
  status           String      @default("Pending") // Waiting/Pending/Progress/Finished/Terminated
  priority         String      @default("Medium") // Low/Medium/High/Urgent
  progress         Int         @default(0)
  subscriberId     String?
  subscriber       Subscriber? @relation(fields: [subscriberId], references: [id]) // cid
  subscriberLegacy Int?
  startDate        DateTime?   @db.Date // sdate
  endDate          DateTime?   @db.Date // edate
  tag              String?
  phase            String?
  note             String?
  worth            Decimal     @default(0) @db.Decimal(18, 2) // presupuesto
  milestones       Milestone[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([subscriberId])
  @@index([status])
}

/// Hito de proyecto (legacy `milestones`).
model Milestone {
  id        String    @id @default(cuid())
  legacyId  Int?      @unique
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  startDate DateTime? @db.Date // sdate
  endDate   DateTime? @db.Date // edate
  detail    String? // exp
  color     String?

  @@index([projectId])
}

// ===== Grupo "valores" (Stock): Inventario, Órdenes, Devoluciones =====

/// Proveedor (legacy `supplier`). category 1=productos, 2=servicios.
model Supplier {
  id           String        @id @default(cuid())
  legacyId     Int?          @unique
  category     Int           @default(1)
  name         String
  nit          String?
  phone        String?
  email        String?
  address      String?
  city         String?
  region       String?
  payMethod    String? // pago
  account      String? // cuenta
  accountType  String? // typo
  bank         String? // banco
  company      String?
  branchRef    Int? // gid
  supplyOrders SupplyOrder[]
  stockReturns StockReturn[]
  createdAt    DateTime      @default(now())

  @@index([category])
}

/// Categoría de compra / gasto (legacy `purchase.idcat`, texto libre → catálogo).
/// El nombre se guarda en `SupplyOrder.categoryRef`.
model PurchaseCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

/// Categoría de material (legacy `product_cat`).
model MaterialCategory {
  id        String     @id @default(cuid())
  legacyId  Int?       @unique
  title     String
  extra     String?
  materials Material[]
}

/// Bodega de material (legacy `product_warehouse`).
model MaterialWarehouse {
  id            String     @id @default(cuid())
  legacyId      Int?       @unique
  title         String
  extra         String?
  technicianRef String? // id_tecnico
  materials     Material[]
}

/// Material / producto de inventario (legacy `products`). Stock = qty por bodega (desnormalizado).
model Material {
  id              String             @id @default(cuid())
  legacyId        Int?               @unique // pid
  categoryId      String?
  category        MaterialCategory?  @relation(fields: [categoryId], references: [id])
  categoryLegacy  Int?
  warehouseId     String?
  warehouse       MaterialWarehouse? @relation(fields: [warehouseId], references: [id])
  warehouseLegacy Int?
  branchRef       Int? // sede
  name            String // product_name
  code            String? // product_code
  price           Decimal            @default(0) @db.Decimal(18, 2) // product_price
  cost            Decimal            @default(0) @db.Decimal(18, 2) // fproduct_price
  taxRate         Decimal            @default(0) @db.Decimal(9, 2)
  discRate        Decimal            @default(0) @db.Decimal(9, 2)
  qty             Int                @default(0) // stock en esta bodega
  description     String?
  alert           Int? // umbral stock bajo
  serviceType     String? // tipo_servicio
  tvOrNet         String? // pertence_a_tv_o_net
  orderItems      SupplyOrderItem[]
  returnItems     StockReturnItem[]
  actaItems       MaterialActaItem[]
  ticketConsumed  TicketMaterial[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([categoryId])
  @@index([warehouseId])
  @@index([name])
}

/// Acta de traspaso de material entre bodegas (legacy `acta_transferencias`).
model MaterialActa {
  id                  String             @id @default(cuid())
  legacyId            Int?               @unique
  date                DateTime
  fromWarehouseLegacy Int?
  toWarehouseLegacy   Int?
  fromWarehouseId     String? // flujo nuevo: bodega origen (dos pasos)
  toWarehouseId       String? // flujo nuevo: bodega destino; su presencia marca acta con lógica en-tránsito
  fromWarehouseName   String?
  toWarehouseName     String?
  observations        String?
  userId              Int?
  createdByName       String?
  assignedToId        String? // flujo nuevo: usuario designado para recibir en destino
  assignedToName      String?
  status              String             @default("Emitida") // Emitida / En tránsito / Recibida
  receivedBy          Int?
  receivedByName      String?
  receivedAt          DateTime?
  itemsCount          Int                @default(0)
  items               MaterialActaItem[]
  createdAt           DateTime           @default(now())
}

/// Línea de acta de traspaso (legacy `items_acta_transferencias`).
model MaterialActaItem {
  id             String       @id @default(cuid())
  legacyId       Int?         @unique
  actaId         String
  acta           MaterialActa @relation(fields: [actaId], references: [id], onDelete: Cascade)
  materialId     String?
  material       Material?    @relation(fields: [materialId], references: [id])
  materialLegacy Int?
  qty            Int          @default(0)
  received       Boolean      @default(false) // checklist de recepción por ítem (flujo nuevo)
  receivedAt     DateTime?

  @@index([actaId])
}

/// Orden de compra/servicio (legacy `purchase`). kind según supplier.category.
model SupplyOrder {
  id             String            @id @default(cuid())
  legacyId       Int?              @unique
  tid            Int               @unique
  supplierId     String?
  supplier       Supplier?         @relation(fields: [supplierId], references: [id])
  supplierLegacy Int?
  orderDate      DateTime?         @db.Date
  dueDate        DateTime?         @db.Date
  subtotal       Decimal           @default(0) @db.Decimal(18, 2)
  shipping       Decimal           @default(0) @db.Decimal(18, 2)
  discount       Decimal           @default(0) @db.Decimal(18, 2)
  tax            Decimal           @default(0) @db.Decimal(18, 2)
  total          Decimal           @default(0) @db.Decimal(18, 2)
  paidAmount     Decimal           @default(0) @db.Decimal(18, 2)
  status         String            @default("pendiente")
  categoryRef    String? // idcat
  warehouseRef   Int? // almacen_seleccionado
  branchRef      String? // refer (sede)
  notes          String?
  itemsCount     Int               @default(0)
  receivedBy     Int?
  receivedAt     DateTime?
  retentionType  String?
  retention      Decimal           @default(0) @db.Decimal(18, 2)
  kind           String            @default("compra") // compra | servicio
  items          SupplyOrderItem[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([supplierId])
  @@index([status])
}

model SupplyOrderItem {
  id             String      @id @default(cuid())
  legacyId       Int?        @unique
  orderId        String
  order          SupplyOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  materialId     String?
  material       Material?   @relation(fields: [materialId], references: [id])
  materialLegacy Int? // pid (0 = nota)
  product        String?
  qty            Int         @default(0)
  price          Decimal     @default(0) @db.Decimal(18, 2)
  taxRate        Decimal     @default(0) @db.Decimal(9, 2)
  discount       Decimal     @default(0) @db.Decimal(18, 2)
  subtotal       Decimal     @default(0) @db.Decimal(18, 2)
  taxTotal       Decimal     @default(0) @db.Decimal(18, 2)
  discountTotal  Decimal     @default(0) @db.Decimal(18, 2)
  description    String?
  receivedQty    Int         @default(0) // qty_en_almacen

  @@index([orderId])
}

/// Devolución de material a proveedor (legacy `stock_return`).
model StockReturn {
  id             String            @id @default(cuid())
  legacyId       Int?              @unique
  tid            Int               @unique
  supplierId     String?
  supplier       Supplier?         @relation(fields: [supplierId], references: [id])
  supplierLegacy Int?
  date           DateTime?         @db.Date
  dueDate        DateTime?         @db.Date
  subtotal       Decimal           @default(0) @db.Decimal(18, 2)
  tax            Decimal           @default(0) @db.Decimal(18, 2)
  discount       Decimal           @default(0) @db.Decimal(18, 2)
  total          Decimal           @default(0) @db.Decimal(18, 2)
  paidAmount     Decimal           @default(0) @db.Decimal(18, 2)
  status         String            @default("pending")
  notes          String?
  itemsCount     Int               @default(0)
  items          StockReturnItem[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([supplierId])
}

model StockReturnItem {
  id             String      @id @default(cuid())
  legacyId       Int?        @unique
  returnId       String
  stockReturn    StockReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  materialId     String?
  material       Material?   @relation(fields: [materialId], references: [id])
  materialLegacy Int?
  product        String?
  qty            Int         @default(0)
  price          Decimal     @default(0) @db.Decimal(18, 2)
  subtotal       Decimal     @default(0) @db.Decimal(18, 2)
  taxTotal       Decimal     @default(0) @db.Decimal(18, 2)

  @@index([returnId])
}

/// Pasarela de pago (legacy `payment_gateways`).
model PaymentGateway {
  id        String  @id @default(cuid())
  legacyId  Int     @unique
  name      String
  enabled   Boolean @default(false) // enable Yes/No
  key1      String
  key2      String?
  currency  String  @default("COP")
  devMode   Boolean @default(false)
  ord       Int     @default(0)
  surcharge Decimal @default(0) @db.Decimal(18, 2)
}

/// Orden de pago en línea del portal del abonado. Unifica el legacy
/// `wompi_data_orden` + `orden_de_pago`: la referencia y la firma se calculan
/// server-side y el webhook se verifica antes de aplicar el pago a cartera vía
/// `treasury.collect` (cascada sobre facturas pendientes). Reemplaza el flujo
/// del CRM legacy que confiaba en el webhook sin validar firma.
model PaymentOrder {
  id            String     @id @default(cuid())
  reference     String     @unique // referencia única enviada a la pasarela
  subscriberId  String
  subscriber    Subscriber @relation(fields: [subscriberId], references: [id])
  gateway       String     @default("wompi") // wompi | payu
  method        String? // CARD | PSE | NEQUI | BANCOLOMBIA_TRANSFER | EFECTY ...
  amount        Decimal    @db.Decimal(18, 2) // COP
  currency      String     @default("COP")
  status        String     @default("PENDING") // PENDING | APPROVED | DECLINED | VOIDED | ERROR
  gatewayTxId   String? // transaction.id de la pasarela
  appliedAt     DateTime? // cuándo se aplicó a cartera (idempotencia)
  transactionId String? // SubTransaction (recaudo) generada al aplicar
  rawInit       Json? // datos de checkout generados
  rawWebhook    Json? // último evento recibido
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([subscriberId])
  @@index([status])
}

/// Cargue masivo de pagos externos (Efecty y otros recaudadores).
/// Reemplaza el legacy `files_carga_transaccional` + `datos_archivo_excel_cargue`.
/// Flujo en dos fases: subir (staging) → procesar (aplica a cartera vía collect).
model PaymentImportBatch {
  id            String             @id @default(cuid())
  fileName      String?
  uploadedById  String?
  status        String             @default("Cargado") // Cargado | Procesado
  totalRows     Int                @default(0)
  appliedRows   Int                @default(0)
  errorRows     Int                @default(0)
  notFoundRows  Int                @default(0)
  duplicateRows Int                @default(0)
  totalAmount   Decimal            @default(0) @db.Decimal(18, 2)
  appliedAmount Decimal            @default(0) @db.Decimal(18, 2)
  rows          PaymentImportRow[]
  createdAt     DateTime           @default(now())

  @@index([status])
}

/// Fila del cargue (una por pago). estado: Inicial | Cargado | Error | Usuario No Existe | Duplicado.
model PaymentImportRow {
  id            String             @id @default(cuid())
  batchId       String
  batch         PaymentImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowNumber     Int // fila en el archivo
  documento     String // columna B (id/abonado/documento del cliente)
  amount        Decimal            @db.Decimal(18, 2) // columna C (monto)
  method        String             @default("EFECTY") // columna D (medio de pago)
  reference     String? // ref_efecty, columna E (idempotencia)
  date          DateTime?          @db.Date // columna A (fecha del pago)
  status        String             @default("Inicial")
  subscriberId  String? // cliente emparejado
  message       String? // detalle del resultado
  transactionId String? // primera transacción de recaudo generada
  createdAt     DateTime           @default(now())

  @@index([batchId])
  @@index([reference])
  @@index([status])
}

// --- Facturación electrónica DIAN (vía Siigo) ---

/// Cuenta Siigo / razón social (mejora el legacy `config_facturacion_electronica`:
/// separa credenciales de parámetros de mapeo, antes hardcodeados en PHP).
model SiigoAccount {
  id              String    @id @default(cuid())
  legacyId        Int?      @unique // config_facturacion_electronica.id
  role            String // 'Tv' | 'Internet' | 'Todo'
  companyName     String? // razón social (Vestel TV, Vestel Internet, Ottis)
  username        String // credencial API Siigo
  accessKey       String // access_key
  token           String? // JWT vigente (tocken)
  tokenExpires    DateTime? // vencimiento del token (nuevo; legacy no lo tenía)
  subscriptionKey String? // del .conf
  apiBaseUrl      String    @default("https://api.siigo.com/v1")
  authUrl         String    @default("https://api.siigo.com/auth")

  // Parámetros de mapeo (antes hardcodeados): documento DIAN, seller, IVA, medios de pago
  documentId           Int? // tipo comprobante DIAN en Siigo (27274, 12434, 28186...)
  creditNoteDocumentId Int? // tipo comprobante DIAN para NOTAS CRÉDITO en Siigo
  sellerId             Int?
  ivaTaxId             Int?
  paymentCredIt        Int? // id medio de pago crédito
  paymentCash          Int? // id medio de pago efectivo
  contactEmail         String?
  costCenterByBranch   Json? // {branchLegacyId: costCenterId}
  active               Boolean @default(true)

  electronicInvoices ElectronicInvoice[]
  createdAt          DateTime            @default(now())
}

/// Emisión de factura electrónica (legacy `facturacion_electronica_siigo`).
/// CORRIGE el defecto legacy: persiste la respuesta DIAN (id Siigo, número, CUFE, PDF, XML).
model ElectronicInvoice {
  id       String @id @default(cuid())
  legacyId Int?   @unique // facturacion_electronica_siigo.id

  siigoAccountId String?
  siigoAccount   SiigoAccount? @relation(fields: [siigoAccountId], references: [id])

  subscriberId String?
  subscriber   Subscriber? @relation(fields: [subscriberId], references: [id]) // customer_id

  invoiceId String?
  invoice   SubInvoice? @relation(fields: [invoiceId], references: [id]) // tid / invoice_id

  date                DateTime           @db.Date // fecha
  executedAt          DateTime? // fecha_ejecucion
  servicesBilled      String? // servicios_facturados (Combo/Television/Internet/Afiliacion)
  createdWithMultiple Boolean            @default(false) // creado_con_multiple
  type                EInvoiceType       @default(FACTURADA) // tipo
  payMethod           EInvoicePayMethod? // metodo_pago

  legacyConsecutive Int?    @default(0) // consecutivo_siigo (legacy siempre 0; vestigio)
  payloadJson       String? // json enviado (y respuesta en errores)

  // --- Respuesta DIAN persistida (NUEVO — el legacy la descartaba) ---
  siigoInvoiceId String? // uuid Siigo
  dianNumber     String? // número DIAN con prefijo
  cufe           String? // CUFE / stamp
  pdfUrl         String? // public_url
  xmlUrl         String?
  errorMessage   String? // error estructurado (en vez de substring en json)

  createdAt DateTime @default(now())

  @@index([subscriberId])
  @@index([invoiceId])
  @@index([type])
  @@index([date]) // listado e-factura: filtra por rango de fecha + ordena por date (evita seq scan de ~222k)
}

// ============================================================================
//  MÓDULO ISP — RED (Mikrotik / OLT / GenieACS / NAP / Puertos / Equipos)
//  Migración fiel de saves-vestel. `legacyId` conserva el PK entero original.
// ============================================================================

/// Router Mikrotik por sede/tecnología (legacy `mikrotiks`).
model Mikrotik {
  id         String   @id @default(cuid())
  legacyId   Int      @unique
  name       String // nombre
  ip         String
  port       String // puerto
  tech       String // tegnologia
  branchId   String?
  branch     Branch?  @relation(fields: [branchId], references: [id])
  sedeLegacy Int // sede (gid)
  username   String
  password   String
  isDefault  Boolean  @default(false) // defecto
  online     Boolean  @default(false) // estado_coneccion
  createdAt  DateTime @default(now())

  @@index([branchId])
}

/// OLT (legacy `olts`).
model Olt {
  id                 String   @id @default(cuid())
  legacyId           Int?     @unique
  name               String
  brand              String // marca
  ip                 String
  port               String   @default("22")
  tech               String   @default("GPON")
  branchId           String?
  branch             Branch?  @relation(fields: [branchId], references: [id])
  sedeLegacy         Int
  username           String
  password           String
  isDefault          Boolean  @default(false)
  online             Boolean  @default(false)
  defaultLineProfile Int?
  defaultSrvProfile  Int?
  defaultVlan        Int?
  defaultGemport     Int?
  defaultUserVlan    Int?
  onus               OltOnu[]
  createdAt          DateTime @default(now())

  @@index([branchId])
}

/// Servidor GenieACS (ACS TR-069). El sistema habla con su NBI (API REST, puerto 7557).
/// A diferencia de Mikrotik/OLT (socket/SSH), aquí GenieACS es quien habla TR-069 con los CPEs.
model GenieacsServer {
  id         String   @id @default(cuid())
  name       String
  nbiUrl     String // URL del NBI, ej: http://host:7557
  username   String   @default("") // basic-auth opcional del NBI (hoy el NBI va sin auth)
  password   String   @default("")
  sedeLegacy Int      @default(0)
  isDefault  Boolean  @default(false)
  online     Boolean  @default(false)
  createdAt  DateTime @default(now())
}

/// ONU/ONT registrada en una OLT (legacy `olt_onus`).
model OltOnu {
  id           String      @id @default(cuid())
  legacyId     Int?        @unique
  oltId        String
  olt          Olt         @relation(fields: [oltId], references: [id], onDelete: Cascade)
  frame        Int         @default(0)
  slot         Int?
  port         Int?
  ontId        Int?
