// ============================================================================
//  HR BASE — Employee (reusable). SST attaches to this; not a duplicate of User.
//  A User (login account) can optionally be linked 1-1 to an Employee.
// ============================================================================

enum EmployeeDocType {
  CC // cédula de ciudadanía
  CE // cédula de extranjería
  TI // tarjeta de identidad
  PASAPORTE
  NIT
  OTRO
}

enum EmployeeStatus {
  ACTIVE // activo
  ON_LEAVE // incapacidad/licencia
  INACTIVE // inactivo
  TERMINATED // retirado
}

model Employee {
  id        String          @id @default(cuid())
  docType   EmployeeDocType @default(CC)
  docNumber String          @unique
  firstName String
  lastName  String
  position  String? // cargo
  area      String?
  hireDate  DateTime?
  birthDate DateTime?
  phone     String?
  email     String?
  bloodType String? // RH
  status    EmployeeStatus  @default(ACTIVE)

  movilMemberships MovilMember[]

  // ---- datos laborales / RRHH ----
  address               String? // dirección de residencia
  city                  String?
  contractType          String? // Indefinido | Término fijo | Obra labor | Prestación de servicios
  salary                Decimal? @db.Decimal(18, 2)
  emergencyContactName  String?
  emergencyContactPhone String?
  eps                   String? // entidad de salud
  arl                   String? // riesgos laborales
  pensionFund           String? // fondo de pensiones (AFP)
  compensationFund      String? // caja de compensación
  bankName              String?
  bankAccount           String?

  // SST profile extras
  laborRestrictions String? // restricciones laborales vigentes
  sstObservations   String?

  // optional link to a system login account (no duplicate identities)
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  documents          EmployeeDocument[] // hojas de vida, cédula, contrato, certificados
  workOrders         WorkOrder[]         @relation("WorkOrderEmployee") // órdenes de trabajo asignadas (sin requerir login)
  inventoryMovements InventoryMovement[] // salidas de inventario entregadas a este funcionario

  risks               SstEmployeeRisk[]
  eppDeliveries       SstEppDelivery[]
  materialAssignments MaterialAssignment[]
  medicalExams        SstMedicalExam[]
  trainings           SstTrainingAttendee[]
  incidentRoles       SstIncidentPerson[]
  brigadeRoles        SstBrigadeMember[]
  drillRoles          SstDrillParticipant[]
  notifications       SstNotification[]

  // ---- nómina (módulo payroll) ----
  payrollContracts PayrollContract[]
  payrollEvents    PayrollEvent[]
  payslips         Payslip[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([area])
  @@index([status])
}

/// Categoría de un archivo adjunto al empleado.
enum EmployeeDocumentKind {
  CV // hoja de vida
  IDENTITY // documento de identidad (cédula)
  CONTRACT // contrato laboral
  CERTIFICATE // certificados / exámenes / otros
  OTHER
}

/// Archivo adjunto a un empleado (PDF/imagen/Word). El binario vive en disco
/// (uploads/employees/) y se descarga por endpoint autenticado, no público.
model EmployeeDocument {
  id           String               @id @default(cuid())
  employeeId   String
  employee     Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  kind         EmployeeDocumentKind @default(OTHER)
  fileName     String // nombre original del archivo
  storedName   String // nombre en disco (único)
  mimeType     String
  size         Int // bytes
  description  String?
  uploadedById String? // usuario que lo subió
  createdAt    DateTime             @default(now())

  @@index([employeeId])
  @@index([kind])
}

