{
  "name": "saves-backend",
  "version": "1.0.0",
  "description": "SAVES (Vestel ISP) - NestJS API",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:status": "prisma migrate status",
    "prisma:seed": "ts-node prisma/seed.ts",
    "prisma:seed:sst": "ts-node prisma/seed-sst.ts",
    "prisma:seed:payroll": "ts-node prisma/seed-payroll.ts",
    "prisma:seed:inventory-modules": "ts-node prisma/seed-inventory-modules.ts",
    "prisma:seed:warehouse-users": "ts-node prisma/seed-warehouse-users.ts",
    "prisma:seed:payroll-provisions": "ts-node prisma/seed-payroll-provisions.ts",
    "smoke:journal": "ts-node prisma/smoke-journal.ts",
    "smoke:purchase-lines": "ts-node prisma/smoke-purchase-lines.ts",
    "smoke:reconciliation": "ts-node prisma/smoke-reconciliation.ts",
    "smoke:crud-guards": "ts-node prisma/smoke-crud-guards.ts",
    "db:reset-inventory": "ts-node prisma/reset-inventory-data.ts",
    "db:backup": "bash scripts/backup-db.sh",
    "db:setup": "prisma generate && prisma migrate deploy && ts-node prisma/seed.ts && ts-node prisma/seed-inventory.ts && ts-node prisma/seed-sst.ts && ts-node prisma/seed-payroll.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/schedule": "^4.1.2",
    "@prisma/client": "^6.2.1",
    "@s4gk/wa-agent": "file:../../wa-agent/s4gk-wa-agent-1.2.0.tgz",
    "@types/nodemailer": "^8.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "exceljs": "^4.4.0",
    "mysql2": "^3.22.5",
    "nodemailer": "^9.0.3",
    "openai": "^6.44.0",
    "pdfkit": "^0.19.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.5",
    "@types/pdfkit": "^0.17.6",
    "@types/ssh2": "^1.15.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^29.7.0",
    "prettier": "^3.9.5",
    "prisma": "^6.2.1",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.64.0"
  }
}
