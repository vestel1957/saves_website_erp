/// Transferencia de equipos entre almacenes (legacy `transfer_equipos`).
model EquipmentTransfer {
  id                String                  @id @default(cuid())
  legacyId          Int?                    @unique // teid (null = creada en el stack nuevo)
  date              DateTime // fecha
  fromWarehouse     String // almacen_origen
  toWarehouse       String // almacen_destino
  fromWarehouseName String? // nombre bodega origen (nuevo)
  toWarehouseName   String? // nombre bodega destino (nuevo)
  observations      String? // observaciones
  userId            Int // id_usuario_que_transfiere (legacy)
  status            String                  @default("Emitida") // Pendiente | En tránsito | Recibida | Rechazada (legacy: Emitida/Completada)
  // Bodegas por id del stack nuevo (para mover el equipo).
  fromWarehouseId   String?
  toWarehouseId     String?
  // Flujo de aprobación (denormalizado, mismo patrón que *WarehouseName).
  requestedById     String? // solicita (técnico)
  requestedByName   String?
  requestedAt       DateTime?
  approvedById      String? // aprueba/despacha (Jefe de bodega / inventario)
  approvedByName    String?
  approvedAt        DateTime?
  receivedById      String? // recibe en la sede destino (caja)
  receivedByName    String?
  receivedAt        DateTime?
  rejectReason      String?
  items             EquipmentTransferItem[]

  @@index([status])
}

/// Ítem de una transferencia de equipos (legacy `item_transfer_equipos`).
model EquipmentTransferItem {
  id              String            @id @default(cuid())
  legacyId        Int?              @unique
  transferId      String
  transfer        EquipmentTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  equipmentId     String?
  equipment       Equipment?        @relation(fields: [equipmentId], references: [id])
  equipmentLegacy Int

  @@index([transferId])
}

// ============================================================================
//  MÓDULO ISP — SOPORTE (Tickets/órdenes, llamadas, encuestas, actas, tareas)
//  Migración fiel de saves-vestel.
// ============================================================================

enum TicketStatus {
  REALIZANDO
  RESUELTO
  ANULADA
  PENDIENTE
}

enum TodoStatus {
  DUE
  DONE
  PROGRESS
}

enum TodoPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// Orden de trabajo / ticket (legacy `tickets`). `detalle` = tipo de orden
/// (Instalacion, Corte, Reconexion, Traslado, etc.). Motor de estados del cliente.
model Ticket {
  id                String           @id @default(cuid())
  legacyId          Int?             @unique // idt (null = creada en el stack nuevo)
  code              Int? // codigo (nº de orden; una orden puede tener varios tickets)
  subject           String
  type              String // detalle (tipo de orden)
  created           DateTime         @db.Date
  subscriberId      String?
  subscriber        Subscriber?      @relation(fields: [subscriberId], references: [id]) // cid
  col               String? // estado/columna
  status            TicketStatus     @default(PENDIENTE)
  priority          String           @default("Media") // Baja / Media / Alta / Urgente
  problem           String? // problema
  section           String? // section (detalle largo)
  finalDate         DateTime?        @db.Date // fecha_final
  invoiceLegacy     Int? // id_invoice
  invoiceBillLegacy Int? // id_factura
  assigned          String? // asignado (técnico)
  par               Int?
  signatureName     String? // nombre_firma
  signatureCc       String? // cc_firma
  signatureRel      String? // parentesco_firma
  signatureImage    String? // ruta del PNG de la firma dibujada (uploads/signatures)
  materials         TicketMaterial[] // material consumido en la orden (descuenta stock)
  createdAt         DateTime         @default(now())

  @@index([subscriberId])
  @@index([code])
  @@index([status])
  @@index([type])
  @@index([created])
  @@index([assigned, created]) // filtro por técnico + orden (evita scan de ~314k filas)
  @@index([priority, created]) // filtro por prioridad + orden
}

/// Material consumido en una orden de servicio. Al registrarse descuenta stock de la
/// bodega (Material.qty). Guarda snapshot de nombre/precio/bodega para el acta/PDF.
model TicketMaterial {
  id            String    @id @default(cuid())
  ticketId      String
  ticket        Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  materialId    String?
  material      Material? @relation(fields: [materialId], references: [id])
  materialName  String // snapshot del nombre
  warehouseId   String? // bodega de la que se descontó
  warehouseName String?
  qty           Int       @default(1)
  price         Decimal   @default(0) @db.Decimal(18, 2) // precio unitario al momento del consumo
  employeeName  String? // técnico/usuario que registró
  createdAt     DateTime  @default(now())

  @@index([ticketId])
  @@index([materialId])
}

/// Mensaje/seguimiento de una orden (legacy `tickets_th`).
model TicketThread {
  id           String      @id @default(cuid())
  legacyId     Int?        @unique
  ticketCode   Int // tid (nº de orden)
  message      String?
  subscriberId String?
  subscriber   Subscriber? @relation(fields: [subscriberId], references: [id]) // cid
  employeeId   Int // eid
  date         DateTime // cdate
  attach       String? // nombre almacenado del archivo (uuid.ext) en uploads/support
  attachName   String? // nombre original del archivo (para mostrar/descargar)
  geoLat       String? // coordenadas del técnico al subir (geo-etiquetado de la evidencia)
  geoLng       String?

  @@index([ticketCode])
  @@index([subscriberId])
}

/// Acta de transferencia de productos entre almacenes (legacy `acta_transferencias`).
model TransferActa {
  id            String             @id @default(cuid())
  legacyId      Int                @unique
  date          DateTime
  fromWarehouse Int // almacen_origen
  toWarehouse   Int // almacen_destino
  observations  String?
  userTransfers Int // id_usuario_que_transfiere
  status        String? // estado (Recibida)
  userReceives  Int? // id_usuario_recibe
  receptionDate DateTime? // fecha_recepcion
  items         TransferActaItem[]
}

/// Ítem de un acta de transferencia (legacy `items_acta_transferencias`).
model TransferActaItem {
  id                    String       @id @default(cuid())
  legacyId              Int          @unique
  productTransferLegacy Int // id_transferencia
  quantity              Int // cantidad
  actaId                String
  acta                  TransferActa @relation(fields: [actaId], references: [id], onDelete: Cascade) // id_acta_transferencia

  @@index([actaId])
}

/// Tarea / to-do ligada a órdenes (legacy `todolist`).
model TodoTask {
  id          String       @id @default(cuid())
  legacyId    Int          @unique
  tdate       DateTime     @db.Date
  name        String?
  status      TodoStatus   @default(DUE)
  start       DateTime?    @db.Date
  dueDate     DateTime?    @db.Date
  description String?
  orderId     Int // idorden
  employeeId  Int // eid
  assigneeId  Int // aid
  related     Int? // related
  priority    TodoPriority @default(MEDIUM)
  rid         Int?
  score       Int? // puntuacion

  @@index([status])
  @@index([orderId])
  @@index([rid, tdate]) // tareas por proyecto + orden
}

/// Archivos adjuntos de un suscriptor (documentos, contratos, imágenes).
/// Los binarios viven en disco (uploads/subscribers/<id>/); aquí solo va la metadata.
model SubscriberFile {
  id             String     @id @default(cuid())
  subscriberId   String
  subscriber     Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  originalName   String // nombre original mostrado al usuario
  storedName     String // nombre en disco (uuid + extensión, no confiable = seguro)
  mimeType       String
  size           Int // bytes
  uploadedByName String? // nombre/email de quien lo subió
  createdAt      DateTime   @default(now())

  @@index([subscriberId])
}

/// Nota/observación libre sobre un suscriptor (bitácora con autor y fecha).
model SubscriberNote {
  id           String     @id @default(cuid())
  subscriberId String
  subscriber   Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  body         String
  authorName   String?
  createdAt    DateTime   @default(now())

  @@index([subscriberId])
}

// ===== Settings globales + API REST pública (paridad legacy: goals, settings, api_keys) =====

/// Metas de negocio anuales (legacy `goals`, fila única id=1). Alimentan el
/// dashboard (comparación real vs meta). Todos los valores en COP enteros.
model BusinessGoal {
  id           String   @id @default(cuid())
  legacyId     Int?     @unique
  income       BigInt   @default(0) // ingresos
  expense      BigInt   @default(0) // egresos
  sales        BigInt   @default(0) // ventas
  netincome    BigInt   @default(0) // utilidad neta
  users        BigInt   @default(0) // usuarios/abonados objetivo
  vesagro      BigInt   @default(0)
  servicios    BigInt   @default(0)
  compras      BigInt   @default(0)
  creditos     BigInt   @default(0)
  nomina       BigInt   @default(0)
  socios       BigInt   @default(0)
  oficial      BigInt   @default(0)
  internet     BigInt   @default(0)
  programadora BigInt   @default(0)
  impuestos    BigInt   @default(0)
  publicos     BigInt   @default(0)
  comisiones   BigInt   @default(0)
  celulares    BigInt   @default(0)
  purchase     BigInt   @default(0)
  updatedAt    DateTime @updatedAt
  updatedBy    String?
}

/// Ajuste global key/value (moneda, SMTP, términos de facturación, cláusula de
/// contrato, etc). `secret=true` ⇒ el valor nunca se devuelve al frontend, solo
/// se enmascara ("hasValue"). `group` agrupa para la UI (moneda|smtp|billing).
/// Estado conversacional del agente de WhatsApp (implementa `SessionStore` del motor).
/// Existe porque el almacén por defecto es en MEMORIA: un `pm2 restart` borraba la
/// acción pendiente, así que el técnico respondía "SÍ" y su corte ya confirmado se
/// evaporaba (o el "SÍ" se colaba al LLM como mensaje suelto). En modo cluster era
/// peor: el `preparePending` quedaba en un worker y el "SÍ" podía llegar a otro.
/// `convKey` es la clave del motor: `<transporte>:<telefono>`, p.ej. `kapso:5730011…`.
model ChatbotSession {
  id        String   @id @default(cuid())
  convKey   String   @unique
  /// Historial de turnos (`Turn[]` del motor), ya recortado a `maxHistory`.
  history   Json     @default("[]")
  /// Acción de escritura a la espera de un SÍ/NO (`StoredPending`). Null = ninguna.
  /// Serializable a propósito: guarda herramienta + input resuelto, no un closure.
  pending   Json?
  /// Cuándo se creó la pendiente, para caducarla sin depender de un timer en memoria.
  pendingAt DateTime?

  /// Conversación escalada a una persona: mientras tenga fecha, el bot NO responde
  /// aquí. El mensaje entrante se sigue registrando (WhatsappLogService), así que un
  /// funcionario lo atiende desde el visor de conversaciones, igual que antes de que
  /// el bot existiera. Sin esto, el prompt le prometía al cliente "te paso a un
  /// asesor" y no pasaba absolutamente nada.
  handoffAt     DateTime?
  /// Lo que el cliente pidió, para que quien lo atienda no arranque de cero.
  handoffReason String?

  updatedAt DateTime @updatedAt

  @@index([updatedAt])
  @@index([handoffAt])
}

/// Consumo diario del LLM del chatbot, agregado por día y modelo. Existe para poner
/// un techo: sin esto nadie contaba tokens y CUALQUIER número desconocido que escriba
/// gasta (el agente público atiende a todo el mundo, por diseño).
/// El dato se toma del `usage` que devuelve OpenAI, capturado en el cliente: el puerto
/// de telemetría del motor no lo trae (su `LlmResponse` no lleva `usage`) y su propia
/// documentación avisa de que no es para facturación.
model ChatbotUsage {
  id           String   @id @default(cuid())
  /// Día natural (UTC) al que se imputa el gasto.
  day          DateTime @db.Date
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  requests     Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([day, model])
  @@index([day])
}

/// Ids de mensaje ya procesados, para deduplicar los reintentos de Kapso. En memoria
/// se perdían al reiniciar y un reintento se procesaba dos veces — que en una escritura
/// confirmada significa ejecutarla dos veces.
model ChatbotSeenMessage {
  messageId String   @id
  seenAt    DateTime @default(now())

  @@index([seenAt])
}

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique // p.ej. "smtp.host", "billing.invoiceTerms"
  value     String? // texto plano; los secretos se enmascaran en el API
  group     String   @default("general")
  secret    Boolean  @default(false)
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@index([group])
}

/// Clave de API para integraciones de terceros (paridad legacy `api_keys`).
/// Se guarda SOLO el hash (sha256 + pepper AUTH_SECRET); la clave en claro se
/// muestra una única vez al crearla. `scopes` limita a lectura por defecto.
model ApiKey {
  id            String    @id @default(cuid())
  legacyId      Int?      @unique
  name          String
  keyHash       String    @unique
  keyPrefix     String // primeros chars visibles p.ej. "sv_live_a1b2…" para identificar
  scopes        String[]  @default(["clients:read"])
  active        Boolean   @default(true)
  ignoreLimits  Boolean   @default(false)
  rateLimit     Int       @default(500) // peticiones/hora (0 = sin límite)
  ipAllowlist   String[]  @default([]) // vacío = cualquier IP
  lastUsedAt    DateTime?
  lastUsedIp    String?
  usageCount    Int       @default(0)
  createdByName String?
  createdAt     DateTime  @default(now())
  revokedAt     DateTime?

  @@index([active])
}
