# Plantilla de entorno del backend de SAVES.
#
# Copiar a `.env` y rellenar. NUNCA se versiona el `.env` real (lo cubre .gitignore);
# esta plantilla existe porque sin ella las ~18 variables sólo vivían en el servidor
# y reconstruir el entorno desde el repositorio era imposible.
#
# `ecosystem.config.js` lee este mismo fichero y ABORTA el arranque si falta alguna
# de las marcadas como obligatorias.
#
#   chmod 600 .env      ← contiene secretos en claro

# ── Obligatorias: sin ellas no arranca en producción ────────────────────────
DATABASE_URL="postgresql://usuario:clave@localhost:5432/saves_vestel?schema=public"
# Orígenes permitidos, separados por coma. Debe incluir el dominio público.
CORS_ORIGIN="https://app.saves.com.co,http://localhost:3060"
# Firma de los JWT. Generar con: openssl rand -hex 32
# DEBE coincidir con el AUTH_SECRET del frontend (.env.local): el middleware del
# edge verifica en el frontend el mismo token que firma el backend.
AUTH_SECRET=

# Cifrado en reposo de las credenciales de routers y OLTs (AES-256-GCM).
# Generar con: openssl rand -hex 32
# ⚠️ INDEPENDIENTE de AUTH_SECRET a propósito: `secret-box` usa AUTH_SECRET como
# respaldo si esta falta, y entonces rotar el secreto de sesión dejaría ILEGIBLES
# todas las contraseñas de los equipos. Si se rota esta, hay que re-cifrarlas
# (scripts/encrypt-network-secrets.ts).
SECRET_ENC_KEY=

PORT=3061

# ── Interruptores peligrosos ────────────────────────────────────────────────
# En 'false' las operaciones se SIMULAN (dry-run) y quedan auditadas sin tocar los
# equipos. En 'true' se ejecutan de verdad. El arranque deja escrito en el log
# cuáles están en vivo.
MIKROTIK_LIVE=false      # corte/reconexión/alta PPPoE contra los routers reales
OLT_LIVE=false           # autorizar/reiniciar/eliminar ONUs por SSH
GENIEACS_LIVE=false      # acciones TR-069
CRONS_ENABLED=false      # facturación recurrente y cartera programadas

# ── Integraciones (opcionales; sólo se exigen si su gate está encendido) ────
WA_AGENT_ENABLED=false
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Sin este secreto el webhook RECHAZA todo (fail-closed, a propósito): es el único
# endpoint sin guard y la firma HMAC es su única barrera.
WHATSAPP_WEBHOOK_APP_SECRET=
WHATSAPP_ALERT_TO=

OPENAI_API_KEY=
WHATSAPP_BOT_MODEL=gpt-4o-mini
WHATSAPP_STT_MODEL=gpt-4o-mini-transcribe

# ── Recibo de caja (rollo térmico) ──────────────────────────────────────────
# Sólo hay que tocarlo si una sede pone una impresora distinta. El valor es el ancho
# que la impresora IMPRIME, no el que mide el rollo: una térmica de 80 mm marca unos
# 72, y una de 58 mm unos 48. Si el recibo sale cortado por la derecha, este número
# está por encima de lo que la impresora puede marcar.
RECIBO_ANCHO_MM=72
RECIBO_MARGEN_MM=2

# ── PlayHub (OTT/IPTV) ──────────────────────────────────────────────────────
# Las credenciales reales viven en el legacy (`variables_de_entorno`, fila PLAYHUB).
# Sin ApiKey/ApiSecret el módulo queda "no configurado" y no llama a la API.
PLAYHUB_BASE_URL=https://www.playhub.com.br/API/PlayhubApi
PLAYHUB_API_KEY=
PLAYHUB_API_SECRET=
# Regla de negocio: PlayHub sólo se asigna con internet de 100 Megas en adelante
# (0 = desactiva el guard).
PLAYHUB_MIN_MEGAS=100
