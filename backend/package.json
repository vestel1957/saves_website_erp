{
  "name": "saves-backend",
  "version": "1.0.0",
  "description": "SAVES (Vestel ISP) - API Express",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "start:prod": "node dist/src/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:status": "prisma migrate status",
    "prisma:seed": "ts-node prisma/seed.ts",
    "prisma:seed:sst": "ts-node prisma/seed-sst.ts",
    "prisma:seed:payroll": "ts-node prisma/seed-payroll.ts",
    "prisma:seed:inventory-modules": "ts-node prisma/seed-inventory-modules.ts",
    "prisma:seed:warehouse-users": "ts-node prisma/seed-warehouse-users.ts",
    "prisma:seed:payroll-provisions": "ts-node prisma/seed-payroll-provisions.ts",
    "banco": "ts-node --transpile-only scripts/banco-chatbot.ts",
    "centroides:barrio": "ts-node --transpile-only scripts/centroides-barrio.ts",
    "smoke:journal": "ts-node prisma/smoke-journal.ts",
    "smoke:prorrateo": "ts-node --transpile-only scripts/smoke-prorrateo-reconexion.ts",
    "smoke:anticipos": "ts-node --transpile-only scripts/smoke-anticipos.ts",
    "smoke:anticipo-sin-factura": "ts-node --transpile-only scripts/smoke-anticipo-sin-factura.ts",
    "smoke:mes-adelantado": "ts-node --transpile-only scripts/smoke-mes-adelantado.ts",
    "smoke:tercero-documento": "ts-node --transpile-only scripts/smoke-tercero-documento.ts",
    "smoke:editar-orden": "ts-node --transpile-only scripts/smoke-editar-orden-superadmin.ts",
    "smoke:playhub-filtros": "ts-node --transpile-only scripts/smoke-playhub-filtros.ts",
    "pagos:portal": "ts-node --transpile-only scripts/reconectar-pagos-portal.ts",
    "secrets:conciliar": "ts-node --transpile-only scripts/conciliar-secrets.ts",
    "red:acceso": "ts-node --transpile-only scripts/verificar-acceso-remoto.ts",
    "verificar:prorrateo": "ts-node --transpile-only scripts/verificar-prorrateo-reconexion.ts",
    "smoke:purchase-lines": "ts-node prisma/smoke-purchase-lines.ts",
    "smoke:reconciliation": "ts-node prisma/smoke-reconciliation.ts",
    "smoke:crud-guards": "ts-node prisma/smoke-crud-guards.ts",
    "smoke:reconexion": "ts-node --transpile-only prisma/smoke-reconexion.ts",
    "db": "bash scripts/psql.sh",
    "db:reset-inventory": "ts-node prisma/reset-inventory-data.ts",
    "db:backup": "bash scripts/backup-db.sh",
    "db:setup": "prisma generate && prisma migrate deploy && ts-node prisma/seed.ts && ts-node prisma/seed-inventory.ts && ts-node prisma/seed-sst.ts && ts-node prisma/seed-payroll.ts",
    "verificar:geocerca": "ts-node scripts/verificar-geocerca.ts",
    "contrato:extraer": "ts-node --transpile-only scripts/extraer-contrato-http.ts --json",
    "contrato:verificar": "ts-node --transpile-only scripts/verificar-contrato-http.ts",
    "generar:contenedor": "ts-node --transpile-only scripts/generar-contenedor.ts --escribir",
    "generar:routers": "ts-node --transpile-only scripts/generar-routers.ts --escribir",
    "smoke:portal-pagos": "ts-node --transpile-only scripts/smoke-portal-pagos.ts",
    "smoke:material-orden": "ts-node --transpile-only scripts/smoke-material-orden.ts",
    "smoke:material-proyecto": "ts-node --transpile-only scripts/smoke-material-proyecto.ts",
    "comparar:portal-pagos": "ts-node --transpile-only scripts/comparar-portal-pagos.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "@s4gk/wa-agent": "^1.3.0",
    "@types/nodemailer": "^8.0.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "cron": "^3.2.1",
    "exceljs": "^4.4.0",
    "express": "^4.22.1",
    "helmet": "^8.3.0",
    "multer": "^2.0.2",
    "mysql2": "^3.22.5",
    "nodemailer": "^9.0.3",
    "openai": "^6.44.0",
    "pdfkit": "^0.19.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.5",
    "@types/pdfkit": "^0.17.6",
    "@types/ssh2": "^1.15.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^29.7.0",
    "prettier": "^3.9.5",
    "prisma": "^6.2.1",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.64.0"
  }
}