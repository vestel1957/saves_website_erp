/// Almacén/bodega de equipos (legacy `almacen_equipos`).
model EquipmentWarehouse {
  id          String      @id @default(cuid())
  legacyId    Int         @unique
  name        String // almacen
  description String? // descripcion
  equipment   Equipment[]
}

/// Equipo/CPE de inventario técnico (legacy `equipos`).
model Equipment {
  id              String              @id @default(cuid())
  legacyId        Int?                @unique
  code            Int                 @unique // codigo
  supplierLegacy  Int                 @default(0) // proveedor
  warehouseId     String?
  warehouse       EquipmentWarehouse? @relation(fields: [warehouseId], references: [id]) // almacen
  warehouseLegacy Int
  mac             String?
  serial          String?
  arrival         DateTime?           @db.Date // llegada
  endDate         DateTime?           @db.Date // final
  brand           String? // marca
  installType     String? // t_instalacion
  port            Int?
  vlan            Int?
  nat             Int?
  subscriberId    String?
  subscriber      Subscriber?         @relation(fields: [subscriberId], references: [id]) // asignado (customer id)
  assignedRaw     String? // asignado (valor original)
  status          String? // estado
  observation     String? // observacion
  master          String? // master
  image           String? // imagen
  meters          Int? // metros
  accessories     String? // accesorios
  genieacsId      String? // id_genieacs

  transferItems EquipmentTransferItem[]

  @@index([warehouseId])
  @@index([subscriberId])
  @@index([status])
